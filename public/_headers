# Security and caching headers.
# 'wasm-unsafe-eval' lets the site search (Pagefind) run its WebAssembly module; it allows no eval().
# Read by Cloudflare Pages and Netlify. Other hosts need the same values in their own config.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# The content panel needs GitHub (its API, avatars and status page) and nothing else. "!" drops the
# site-wide policy above so only this one applies here.
/panel
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.githubusercontent.com https://raw.githubusercontent.com; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' data: blob: https://api.github.com https://raw.githubusercontent.com https://www.githubstatus.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Apple reads this file without an extension and expects JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=86400

/videos/*
  Cache-Control: public, max-age=604800
