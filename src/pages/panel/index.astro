---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@/panel/theme.css";

/**
 * Content panel. The app (Sveltia CMS) mounts itself on <body>; this page only loads it with the
 * site's configuration. Kept out of search engines and the sitemap.
 */
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ryvex Studio Panel</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <noscript>Panel için JavaScript gerekir.</noscript>
    <script>
      import CMS from "@sveltia/cms";
      import { panelConfig } from "@/panel/config";

      CMS.init({ config: panelConfig });
    </script>
  </body>
</html>
