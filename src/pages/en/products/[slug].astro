---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductDetail from "@/components/pages/ProductDetail.astro";
import { getProducts, productTagline, type Product } from "@/lib/products";
import { productSchema } from "@/lib/schema";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
---

<BaseLayout
  title={product.data.name}
  description={productTagline(product, "en")}
  ogImage={`/og/products/${product.id}-en.png`}
  jsonLd={[productSchema(product, "en")]}
>
  <ProductDetail product={product} lang="en" />
</BaseLayout>
