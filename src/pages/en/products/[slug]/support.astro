---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductSupport from "@/components/pages/ProductSupport.astro";
import { getProducts, type Product } from "@/lib/products";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
---

<BaseLayout title={`Support: ${product.data.name}`} ogImage={`/og/products/${product.id}-en.png`}>
  <ProductSupport product={product} lang="en" />
</BaseLayout>
