---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JournalPost from "@/components/pages/JournalPost.astro";
import { getPosts, postSlug, type Post } from "@/lib/journal";
import { articleSchema } from "@/lib/schema";

export async function getStaticPaths() {
  const posts = await getPosts("en");
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  jsonLd={[articleSchema(post.data, `/en/journal/${postSlug(post)}`, "en")]}
>
  <JournalPost post={post} lang="en" />
</BaseLayout>
