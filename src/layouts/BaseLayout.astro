---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SearchPalette from "@/components/SearchPalette.astro";
import LaunchAnnounce from "@/components/LaunchAnnounce.astro";
import { freshProducts } from "@/lib/launch";
import { getProducts } from "@/lib/products";
import { breadcrumbSchema } from "@/lib/schema";
import { site } from "@/config/site";
import { alternatePath, getLangFromUrl, useTranslations } from "@/i18n/ui";

interface Props {
  title?: string;
  description?: string;
  /** Path of the Open Graph image, e.g. /og/products/kelimo-tr.png */
  ogImage?: string;
  /** Structured data objects rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
  /** App Store id of the page's product: Safari on iPhone then offers the app in its own banner. */
  appStoreId?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = site.description[lang],
  ogImage = `/og/site-${lang}.png`,
  jsonLd = [],
  appStoreId,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline[lang]}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isNotFound = Astro.url.pathname.startsWith("/404");
const alternates = isNotFound
  ? []
  : [
      { hreflang: "tr", href: new URL(alternatePath(Astro.url, "tr"), Astro.site) },
      { hreflang: "en", href: new URL(alternatePath(Astro.url, "en"), Astro.site) },
      { hreflang: "x-default", href: new URL(alternatePath(Astro.url, "tr"), Astro.site) },
    ];
const ogImageUrl = new URL(ogImage, Astro.site);
const crumbs = isNotFound ? undefined : await breadcrumbSchema(Astro.url, title, lang);
// Products released in the last 30 days. Whether they are still new is decided again in the browser.
const fresh = freshProducts(await getProducts()).map((f) => ({ id: f.product.id, until: f.until.getTime() }));
const freshStyle = fresh
  .map((f) => `html[data-new~="${f.id}"] [data-new-chip="${f.id}"]{display:inline-flex}html[data-announce="${f.id}"] .announce[data-product="${f.id}"]{display:block}`)
  .join("");
// The text face is preloaded so the first paint already uses it (Latin and Turkish letters).
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistLatinExt from "@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2?url";
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === "tr" ? `${site.name} Günlük` : `${site.name} Journal`}
      href={`${lang === "tr" ? "/gunluk" : "/en/journal"}/rss.xml`}
    />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#160F12" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    {
      [...jsonLd, ...(crumbs ? [crumbs] : [])].map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }

    <script is:inline>
      // Apply the theme before first paint, and again after every client-side navigation: the
      // visitor's own choice if they made one, otherwise their device's light or dark setting.
      (function () {
        var system = window.matchMedia("(prefers-color-scheme: dark)");
        function applyTheme(doc) {
          var saved = null;
          try {
            saved = localStorage.getItem("rv-theme");
          } catch (e) {}
          var theme = saved === "dark" || saved === "light" ? saved : system.matches ? "dark" : "light";
          doc.documentElement.dataset.theme = theme;
        }
        applyTheme(document);
        if (!window.__rvThemeBound) {
          window.__rvThemeBound = true;
          document.addEventListener("astro:before-swap", function (e) {
            applyTheme(e.newDocument);
          });
          // Follows the device when it switches (e.g. at sunset), unless a choice was made here.
          system.addEventListener("change", function () {
            applyTheme(document);
            document.dispatchEvent(new CustomEvent("rv:theme-sync"));
          });
        }
      })();
    </script>
    <script is:inline>
      // First visit in a session: play the short opening (the mark draws, then the page settles).
      // Never for visitors who prefer reduced motion.
      (function () {
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          if (sessionStorage.getItem("rv-intro")) return;
          sessionStorage.setItem("rv-intro", "1");
          document.documentElement.classList.add("rv-intro");
        } catch (e) {}
      })();
    </script>
    <script is:inline define:vars={{ rvFresh: fresh }}>
      // Before first paint, and again for every page the router swaps in: the visitor's platform
      // (the right store first, the right download link) and which products are still new.
      (function () {
        var ua = navigator.userAgent;
        var ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        var platform = /Android/.test(ua) ? "android" : ios ? "ios" : "other";
        var safari = ios && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS/.test(ua);
        function apply(doc) {
          var root = doc.documentElement;
          var now = Date.now();
          var ids = rvFresh.filter(function (f) { return f.until > now; }).map(function (f) { return f.id; });
          var closed = null;
          try { closed = localStorage.getItem("rv-announce-closed"); } catch (e) {}
          root.dataset.platform = platform;
          if (safari) root.dataset.iosSafari = "";
          if (ids.length) root.dataset.new = ids.join(" ");
          if (ids.length && ids[0] !== closed) root.dataset.announce = ids[0];
        }
        apply(document);
        if (!window.__rvLaunchBound) {
          window.__rvLaunchBound = true;
          document.addEventListener("astro:before-swap", function (e) { apply(e.newDocument); });
        }
      })();
    </script>
    {freshStyle && <style is:inline set:html={freshStyle} />}
    {appStoreId && <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />}
    <ClientRouter fallback="swap" />
    {
      /* Cookieless visit counts, only once a Cloudflare Web Analytics token is set. */
      site.integrations.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.integrations.analyticsToken, spa: true })}
        />
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-tertiary focus:px-4 focus:py-2 focus:text-on-tertiary"
    >
      {t("skip.content")}
    </a>
    <div class="intro" aria-hidden="true">
      <svg class="intro-mark" viewBox="0 0 64 64" focusable="false">
        <rect class="intro-tile" width="64" height="64" rx="14.4" fill="#8E1B3B"></rect>
        <clipPath id="rv-intro-clip"><rect width="64" height="64" rx="14.4"></rect></clipPath>
        <g clip-path="url(#rv-intro-clip)" fill="none" stroke="#FFFFFF" stroke-width="8">
          <path class="intro-stroke" pathLength="1" d="M24 16V48"></path>
          <path class="intro-stroke" pathLength="1" d="M20 20H33A7 7 0 0 1 33 34H24" stroke-linejoin="round"></path>
          <path class="intro-stroke" pathLength="1" d="M31 34L64 67"></path>
        </g>
      </svg>
      <p class="intro-caption">{site.tagline[lang]}</p>
    </div>
    <LaunchAnnounce />
    <Header />
    {/* Search indexes only the page content, titled as in the browser tab without the site name. */}
    <main
      id="icerik"
      class="flex-1"
      data-pagefind-body={isNotFound ? undefined : ""}
      data-pagefind-meta={isNotFound ? undefined : `title:${title ?? site.name}`}
    >
      <slot />
    </main>
    <Footer />
    <SearchPalette />
    <script>
      import "@/scripts/motion";
      import "@/scripts/instant";
    </script>
  </body>
</html>
