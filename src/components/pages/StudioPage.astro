---
import ClosingBand from "@/components/ClosingBand.astro";
import { Image } from "astro:assets";
import Process from "@/components/Process.astro";
import { site } from "@/config/site";
import { route, type Lang } from "@/i18n/ui";
import { getProducts, platformLabels, productCaption } from "@/lib/products";
import { studioFaq } from "@/data/studio-faq";
import { monthLabel, text, timeline } from "@/lib/studio";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const products = await getProducts();
const productBase = route("products", lang);
// Facts beside the statement come from the products themselves.
const platformOrder = ["android", "ios", "web"] as const;
const platforms = platformOrder.filter((pl) => products.some((p) => p.data.platforms.includes(pl)));
const glow = products.slice(0, 3).map((p) => p.data.color);

const copy = {
  tr: {
    title: "Stüdyo",
    statement: "Mobil uygulamalar, oyunlar ve web ürünleri tasarlıyor, geliştiriyor ve yayınlıyoruz.",
    detail: `Ryvex Studio, ${site.founder} tarafından kuruldu. Tasarım, geliştirme, yayın ve destek aynı çatı altında yürür; her ürün aynı kalite standardından geçer ve arkasında adı bilinen bir sorumlu bulunur.`,
    principlesTitle: "Neye önem veriyoruz",
    principles: [
      ["Özen", "Detaylar tesadüf değil."],
      ["Tek imza", "Her ürün aynı standarttan geçer."],
      ["Şeffaflık", "Ne yaptığımızı açıkça söyleriz."],
      ["Ulaşılabilirlik", "Her sorunun cevabı var."],
      ["Keyif", "Kullanması insanı mutlu etmeli."],
    ],
    familyTitle: "Ryvex ailesi",
    noteTitle: "Kurucudan",
    note: [
      "Ryvex Studio'yu, uygulamaların, oyunların ve web ürünlerinin tek bir kalite anlayışıyla yapılabileceğine inandığım için kurdum.",
      "Her ürün, kendim kullanmak isteyeceğim seviyeye gelmeden yayınlanmaz. Yayından sonra da işimiz bitmez: sorularınızı yanıtlar, verinize saygı gösterir ve ürünlerimizi geliştirmeye devam ederiz.",
    ],
    noteRole: "Kurucu",
    facts: {
      founder: "Kurucu",
      scope: "Kapsam",
      scopeValue: "Tasarım, geliştirme, yayın ve destek",
      products: "Ürünler",
      productsValue: (n: number, pl: string) => `${n} ürün; ${pl}`,
      and: " ve ",
    },
    faqTitle: "Sık sorulan sorular",
    storyTitle: "Hikâyemiz",
    upcoming: "Yakında",
  },
  en: {
    title: "Studio",
    statement: "We design, build and publish mobile apps, games and web products.",
    detail: `Ryvex Studio was founded by ${site.founder}. Design, development, publishing and support happen under one roof; every product meets the same quality standard and has a named person behind it.`,
    principlesTitle: "What we care about",
    principles: [
      ["Care", "Details are never an accident."],
      ["One signature", "Every product meets the same standard."],
      ["Transparency", "We say plainly what we do."],
      ["Reachability", "Every question gets an answer."],
      ["Delight", "Using it should feel good."],
    ],
    familyTitle: "The Ryvex family",
    noteTitle: "From the founder",
    note: [
      "I founded Ryvex Studio because I believe apps, games and web products can all be made to one standard of quality.",
      "No product is released before it is something I would want to use myself. Our work does not end at release either: we answer your questions, respect your data and keep improving our products.",
    ],
    noteRole: "Founder",
    facts: {
      founder: "Founder",
      scope: "Scope",
      scopeValue: "Design, development, publishing and support",
      products: "Products",
      productsValue: (n: number, pl: string) => `${n} products; ${pl}`,
      and: " and ",
    },
    faqTitle: "Frequently asked questions",
    storyTitle: "Our story",
    upcoming: "Coming soon",
  },
}[lang];
---

<!--
  The studio introduces itself on a deep ground lit by its products' colours. The statement rises
  word by word once; the facts below it are the plain record.
-->
<section class="studio-band relative isolate flex flex-col justify-center overflow-hidden text-primary md:min-h-[calc(100svh-73px)]" data-theme="dark">
  <div
    class="studio-glow"
    style={`--c1:${glow[0] ?? "#8E1B3B"};--c2:${glow[1] ?? "#8E1B3B"};--c3:${glow[2] ?? "#8E1B3B"}`}
    aria-hidden="true"
  ></div>
  <div class="container-page w-full pt-20 pb-16 md:py-16">
    <h1 class="hero-settle text-body-lg text-secondary" style="--i:0">{copy.title}</h1>
    <p
      class="rise-words mt-6 max-w-[19ch] text-[2.5rem] leading-[1.04] font-semibold tracking-[-0.04em] md:text-[4.5rem] md:leading-[1.02]"
    >
      <span class="sr-only">{copy.statement}</span>
      {
        copy.statement.split(" ").map((word, i, all) => (
          <>
            <span class="w" aria-hidden="true">
              <span style={`--i:${i}`}>{word}</span>
            </span>
            {i < all.length - 1 && " "}
          </>
        ))
      }
    </p>
    <p class="hero-settle mt-8 max-w-[56ch] text-body-lg text-secondary" style="--i:2">{copy.detail}</p>
    <dl class="hero-settle mt-14 grid gap-8 border-t border-outline pt-8 sm:grid-cols-3" style="--i:3">
      <div>
        <dt class="text-body-sm text-secondary">{copy.facts.founder}</dt>
        <dd class="mt-2 text-title font-semibold">{site.founder}</dd>
      </div>
      <div>
        <dt class="text-body-sm text-secondary">{copy.facts.scope}</dt>
        <dd class="mt-2 text-title font-semibold">{copy.facts.scopeValue}</dd>
      </div>
      <div>
        <dt class="text-body-sm text-secondary">{copy.facts.products}</dt>
        <dd class="mt-2 text-title font-semibold">
          {copy.facts.productsValue(products.length, platforms.map((pl) => platformLabels[lang][pl]).join(copy.facts.and))}
        </dd>
      </div>
    </dl>
  </div>
</section>

<section aria-labelledby="kurucudan" class="container-page pt-section-mobile md:pt-section">
  <div class="mx-auto max-w-[44rem] border-l-2 border-tertiary pl-8 md:pl-12">
    <h2 id="kurucudan" class="text-body-lg text-secondary">{copy.noteTitle}</h2>
    {copy.note.map((paragraph, i) => (
      <p class:list={["text-[1.375rem] leading-[1.5] tracking-[-0.01em] md:text-[1.625rem]", i === 0 ? "mt-6" : "mt-5"]}>{paragraph}</p>
    ))}
    <p class="mt-8 text-title font-semibold">{site.founder}</p>
    <p class="text-body-sm text-secondary">{copy.noteRole}, {site.name}</p>
    <a href={`mailto:${site.contactEmail}`} class="link-inline mt-3 inline-block text-body-md">{site.contactEmail}</a>
  </div>
</section>

<section aria-labelledby="aile" class="container-page py-section-mobile md:py-section">
  <h2 id="aile" class="text-headline-lg font-semibold">{copy.familyTitle}</h2>
  <ul class="mt-10 flex flex-wrap gap-x-12 gap-y-10">
    {
      products.map((product) => (
        <li>
          <a href={`${productBase}/${product.id}`} class="wall-link group block w-[140px]" data-color={product.data.color} data-flood={product.data.color}>
            <Image
              src={product.data.icon}
              alt=""
              width={140}
              height={140}
              class="wall-icon shape-icon object-depth size-[140px]"
            />
            <span class="mt-4 block text-title font-semibold group-hover:underline">{product.data.name}</span>
            <span class="mt-1 block text-body-sm text-secondary">{productCaption(product, lang)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<!-- The studio so far, from the panel (Ayarlar › Stüdyonun hikâyesi). The line fills as you read. -->
<section aria-labelledby="hikaye" class="container-page pb-section-mobile md:pb-section">
  <h2 id="hikaye" class="text-center text-headline-lg font-semibold">{copy.storyTitle}</h2>
  <ol class="timeline mt-12" data-timeline>
    {
      timeline.items.map((item, i) => (
        <li class="timeline-stop" data-side={i % 2 ? "right" : "left"} data-upcoming={item.date ? undefined : ""}>
          <span class="timeline-dot" aria-hidden="true" />
          <div class="timeline-card">
            <p class="font-mono text-mono-sm text-secondary">
              {item.date ? <time datetime={item.date}>{monthLabel(item.date, lang)}</time> : copy.upcoming}
            </p>
            <p class="mt-2 text-title font-semibold">{text(item.title, lang)}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<section aria-labelledby="ilkeler" class="container-page pb-section-mobile md:pb-section">
  <h2 id="ilkeler" class="text-headline-lg font-semibold">{copy.principlesTitle}</h2>
  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {
      copy.principles.map(([term, text], i) => (
        <li class:list={["rounded-xl p-6", i === 0 ? "bg-tertiary text-on-tertiary" : "bg-neutral"]}>
          <h3 class="text-headline-md font-semibold">{term}</h3>
          <p class:list={["mt-8 text-body-sm", i === 0 ? "opacity-90" : "text-secondary"]}>{text}</p>
        </li>
      ))
    }
  </ul>
</section>

<Process lang={lang} compact />

<section aria-labelledby="sss" class="container-page pb-section-mobile md:grid md:grid-cols-12 md:gap-6 md:pb-section">
  <h2 id="sss" class="text-headline-lg font-semibold md:col-span-4">{copy.faqTitle}</h2>
  <div class="mt-8 border-t border-outline md:col-span-8 md:mt-0">
    {
      studioFaq[lang].map((item) => (
        <details class="group border-b border-outline">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-body-lg font-medium text-primary [&::-webkit-details-marker]:hidden">
            {item.q}
            <svg
              class="size-5 shrink-0 text-secondary transition-transform duration-200 group-open:rotate-45"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="max-w-[60ch] pb-6 text-body-md text-secondary">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<ClosingBand lang={lang} />

<script>
  let stopTimeline: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    stopTimeline?.();
    stopTimeline = null;
    const list = document.querySelector<HTMLElement>("[data-timeline]");
    if (!list) return;
    const stops = [...list.querySelectorAll<HTMLElement>(".timeline-stop")];
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      list.style.setProperty("--tl", "1");
      stops.forEach((s) => s.classList.add("is-reached"));
      return;
    }
    list.classList.add("is-animated");
    let frame = 0;
    const update = () => {
      frame = 0;
      const mark = window.innerHeight * 0.62;
      const r = list.getBoundingClientRect();
      list.style.setProperty("--tl", Math.min(1, Math.max(0, (mark - r.top) / r.height)).toFixed(4));
      stops.forEach((s) => s.classList.toggle("is-reached", s.getBoundingClientRect().top < mark));
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    stopTimeline = () => {
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
    };
    update();
  });
</script>
