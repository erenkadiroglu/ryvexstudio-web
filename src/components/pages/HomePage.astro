---
import PhoneFrame from "@/components/PhoneFrame.astro";
import ProductWall from "@/components/ProductWall";
import Showcase from "@/components/Showcase.astro";
import Disciplines from "@/components/Disciplines.astro";
import Manifesto from "@/components/Manifesto.astro";
import JournalTeaser from "@/components/JournalTeaser.astro";
import ClosingBand from "@/components/ClosingBand.astro";
import { site } from "@/config/site";
import { route, type Lang } from "@/i18n/ui";
import { getProducts, toWallItem } from "@/lib/products";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const products = await getProducts();
const items = products.map((p) => toWallItem(p, lang));
const featured = products.filter((p) => p.data.featured);

// The hero shows the products themselves: three real screens, the first in front.
const heroPhones = products.filter((p) => p.data.screenshots[0]).slice(0, 3);
// Front, left and right places; depth is how strongly each follows the pointer and the scroll.
const phonePlaces = [
  { width: 252, left: "calc(50% - 126px)", top: "0px", r: "0deg", dy: "-10px", d: "9s", depth: 1, z: 3 },
  { width: 204, left: "calc(50% - 262px)", top: "78px", r: "-7deg", dy: "-8px", d: "8s", depth: 0.55, z: 2 },
  { width: 204, left: "calc(50% + 58px)", top: "78px", r: "7deg", dy: "-12px", d: "10s", depth: 0.7, z: 1 },
];

const copy = {
  tr: {
    lede: "Mobil uygulamalar, oyunlar ve web projeleri. Hepsi tek imza altında, aynı titizlikle.",
    primary: "Ürünleri keşfet",
    secondary: "Stüdyoyu tanı",
    wallHeading: "Ürünlerimiz",
  },
  en: {
    lede: "Mobile apps, games and web products. All under one signature, made with the same care.",
    primary: "Explore products",
    secondary: "Meet the studio",
    wallHeading: "Our products",
  },
}[lang];
---

<section class="container-page grid items-center gap-10 pt-20 pb-24 md:pt-28 md:pb-32 lg:grid-cols-12">
  <div class="lg:col-span-7">
    <h1
      class="text-display-mobile leading-[0.98] font-semibold tracking-[-0.045em] md:text-display"
      aria-label={site.tagline[lang]}
    >
      {
        site.taglineLines[lang].map((line, i) => (
          <span class="hero-line" aria-hidden="true">
            <span style={`--i:${i}`}>{line}</span>
          </span>
        ))
      }
    </h1>
    <p class="hero-settle mt-8 max-w-[38ch] text-body-lg text-secondary" style="--i:0">
      {copy.lede}
    </p>
    <div class="hero-settle mt-10 flex flex-wrap gap-3" style="--i:1">
      <a
        href={route("products", lang)}
        data-magnetic
        class="inline-flex rounded-full bg-tertiary px-[22px] py-[14px] text-label font-medium text-on-tertiary transition-colors duration-150 hover:bg-tertiary-hover"
      >
        {copy.primary}
      </a>
      <a
        href={route("studio", lang)}
        class="inline-flex rounded-full border border-outline bg-surface px-[21px] py-[13px] text-label font-medium text-primary transition-colors duration-150 hover:bg-neutral active:bg-neutral-strong"
      >
        {copy.secondary}
      </a>
    </div>
  </div>

  <div class="hero-phones relative hidden h-[620px] lg:col-span-5 lg:block" aria-hidden="true">
    {
      heroPhones.map((product, i) => {
        const place = phonePlaces[i];
        return (
          <div
            class="hero-phone absolute"
            style={`left:${place.left};top:${place.top};z-index:${place.z}`}
            data-depth={place.depth}
          >
            <div class="hero-float" style={`--i:${i};--r:${place.r};--dy:${place.dy};--d:${place.d}`}>
              <PhoneFrame src={product.data.screenshots[0].src} alt="" width={place.width} loading="eager" />
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<section aria-labelledby="duvar" class="container-page pb-section-mobile md:pb-section">
  <h2 id="duvar" class="sr-only">{copy.wallHeading}</h2>
  <ProductWall items={items} animate />
</section>

<Manifesto lang={lang} />

<Disciplines products={products} lang={lang} />

{featured.length > 0 && <Showcase products={featured} lang={lang} />}

<JournalTeaser lang={lang} />

<ClosingBand lang={lang} />
