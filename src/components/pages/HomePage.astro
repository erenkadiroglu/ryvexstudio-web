---
import { Image } from "astro:assets";
import ProductWall from "@/components/ProductWall";
import Showcase from "@/components/Showcase.astro";
import Disciplines from "@/components/Disciplines.astro";
import Manifesto from "@/components/Manifesto.astro";
import JournalTeaser from "@/components/JournalTeaser.astro";
import ClosingBand from "@/components/ClosingBand.astro";
import ScreenReel from "@/components/ScreenReel.astro";
import { site } from "@/config/site";
import { route, type Lang } from "@/i18n/ui";
import { getProducts, toWallItem } from "@/lib/products";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const products = await getProducts();
const items = products.map((p) => toWallItem(p, lang));
const featured = products.filter((p) => p.data.featured);

// Hand-placed composition for the drifting icons on the right of the hero.
const constellation = [
  // depth: how strongly the icon follows the pointer (near icons move more).
  { top: "2%", left: "48%", size: 136, r: "4deg", dy: "-12px", d: "9s", depth: 0.8 },
  { top: "30%", left: "4%", size: 108, r: "-6deg", dy: "-9px", d: "7.5s", depth: 0.6 },
  { top: "40%", left: "60%", size: 150, r: "-3deg", dy: "-14px", d: "10s", depth: 1 },
  { top: "72%", left: "24%", size: 92, r: "5deg", dy: "-8px", d: "8s", depth: 0.45 },
  { top: "4%", left: "10%", size: 72, r: "8deg", dy: "-7px", d: "6.5s", depth: 0.3 },
  { top: "78%", left: "74%", size: 80, r: "-8deg", dy: "-10px", d: "8.5s", depth: 0.35 },
];
const floating = products.slice(0, constellation.length);
// With only a few products, give them the largest, most central spots.
const spots =
  floating.length < constellation.length
    ? [...constellation].sort((a, b) => b.size - a.size)
    : constellation;

const copy = {
  tr: {
    lede: "Mobil uygulamalar, oyunlar ve web projeleri. Hepsi tek imza altında, aynı titizlikle.",
    primary: "Ürünleri keşfet",
    secondary: "Stüdyoyu tanı",
    wallHeading: "Ürünlerimiz",
    studioHeading: "Tek masadan, her ekrana",
    studio: [
      `Ryvex Studio, ${site.founder} tarafından kurulan bağımsız bir ürün stüdyosu. Uygulamalarımızı, oyunlarımızı ve web projelerimizi aynı masada tasarlıyor, aynı standartla yayınlıyoruz.`,
      "Her ürün, kendimiz kullanmak isteyeceğimiz seviyeye gelene kadar işleniyor. Ne yaptığını açıkça anlatan, verinize saygı gösteren ve açıldığında insanı yormayan ürünler yapıyoruz.",
    ],
    studioLink: "Stüdyo hakkında daha fazlası",
    imageAlt: `Ryvex Studio'nun kurucusu ${site.founder}`,
  },
  en: {
    lede: "Mobile apps, games and web products. All under one signature, made with the same care.",
    primary: "Explore products",
    secondary: "Meet the studio",
    wallHeading: "Our products",
    studioHeading: "One desk, every screen",
    studio: [
      `Ryvex Studio is an independent product studio founded by ${site.founder}. Our apps, games and web products are designed at the same desk and released to the same standard.`,
      "Every product is refined until it is something we would want to use ourselves. We make products that say clearly what they do, respect your data and never wear you out.",
    ],
    studioLink: "More about the studio",
    imageAlt: `${site.founder}, founder of Ryvex Studio`,
  },
}[lang];
---

<section class="container-page grid items-center gap-10 pt-20 pb-24 md:grid-cols-12 md:pt-28 md:pb-32">
  <div class="md:col-span-7">
    <h1
      class="text-display-mobile leading-[0.98] font-semibold tracking-[-0.045em] md:text-display"
      aria-label={site.tagline[lang]}
    >
      {
        site.taglineLines[lang].map((line, i) => (
          <span class="hero-line" aria-hidden="true">
            <span style={`--i:${i}`}>{line}</span>
          </span>
        ))
      }
    </h1>
    <p class="hero-settle mt-8 max-w-[38ch] text-body-lg text-secondary" style="--i:0">
      {copy.lede}
    </p>
    <div class="hero-settle mt-10 flex flex-wrap gap-3" style="--i:1">
      <a
        href={route("products", lang)}
        data-magnetic
        class="inline-flex rounded-full bg-tertiary px-[22px] py-[14px] text-label font-medium text-on-tertiary transition-colors duration-150 hover:bg-tertiary-hover"
      >
        {copy.primary}
      </a>
      <a
        href={route("studio", lang)}
        class="inline-flex rounded-full border border-outline bg-surface px-[21px] py-[13px] text-label font-medium text-primary transition-colors duration-150 hover:bg-neutral active:bg-neutral-strong"
      >
        {copy.secondary}
      </a>
    </div>
  </div>

  <div class="relative isolate hidden h-[460px] md:col-span-5 md:block" aria-hidden="true">
    <div
      class="hero-glow"
      style={`--c1:${floating[0]?.data.color ?? "#8e1b3b"};--c2:${floating[1]?.data.color ?? "#8e1b3b"};--c3:${floating[2]?.data.color ?? "#8e1b3b"}`}
    ></div>
    {
      floating.map((product, i) => {
        const spot = spots[i];
        return (
          <div
            class="hero-depth absolute"
            style={`top:${spot.top};left:${spot.left}`}
            data-product={product.id}
            data-depth={spot.depth}
          >
            <div class="hero-float" style={`--i:${i};--r:${spot.r};--dy:${spot.dy};--d:${spot.d}`}>
              <Image
                src={product.data.icon}
                alt=""
                width={spot.size}
                height={spot.size}
                loading="eager"
                class="shape-icon object-depth"
                style={`width:${spot.size}px;height:${spot.size}px`}
              />
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<section aria-labelledby="duvar" class="container-page pb-section-mobile md:pb-section">
  <h2 id="duvar" class="sr-only">{copy.wallHeading}</h2>
  <ProductWall items={items} animate />
</section>

<ScreenReel products={products} lang={lang} />

<Manifesto lang={lang} />

<Disciplines products={products} lang={lang} />

{featured.length > 0 && <Showcase products={featured} lang={lang} />}

<JournalTeaser lang={lang} />

<ClosingBand lang={lang} />
