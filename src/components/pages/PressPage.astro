---
import BrandPattern from "@/components/BrandPattern.astro";
import Image from "@/components/Img.astro";
import { site } from "@/config/site";
import { route, type Lang } from "@/i18n/ui";
import { getProducts, productCaption } from "@/lib/products";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const products = await getProducts();
const productBase = route("products", lang);
const glow = products.slice(0, 3).map((p) => p.data.color);

const colors = [
  { name: lang === "tr" ? "Vişne" : "Vişne (cherry)", hex: "#8E1B3B", text: "#FFFFFF" },
  { name: lang === "tr" ? "Mürekkep" : "Mürekkep (ink)", hex: "#1C1418", text: "#FFFFFF" },
  { name: lang === "tr" ? "Beyaz" : "Beyaz (white)", hex: "#FFFFFF", text: "#1C1418" },
];

const copy = {
  tr: {
    title: "Basın kiti",
    lede: "Ryvex Studio hakkında yazmak için ihtiyacınız olan her şey.",
    aboutTitle: "Hakkımızda",
    short: "Ryvex Studio, mobil uygulamalar, oyunlar ve web projeleri üreten bağımsız bir stüdyodur.",
    long: `Ryvex Studio, ${site.founder} tarafından kurulan bağımsız bir dijital ürün stüdyosudur. Mobil uygulamalar, oyunlar ve web projeleri tek bir imza ve aynı kalite standardıyla tasarlanıp geliştirilir. Stüdyonun sloganı: "${site.tagline.tr}"`,
    shortLabel: "Kısa tanıtım",
    longLabel: "Uzun tanıtım",
    factsTitle: "Künye",
    facts: [
      ["Kurucu", site.founder],
      ["Web sitesi", "ryvexstudio.com"],
      ["Sosyal medya", "@ryvexstudio (Instagram, TikTok, YouTube)"],
      ["Basın iletişimi", site.contactEmail],
    ],
    logoTitle: "Logo",
    logoText:
      "Logoyu ve sembolü olduğu gibi kullanın: esnetmeyin, döndürmeyin, yeniden renklendirmeyin ve efekt eklemeyin. Çevresinde en az sembol yüksekliğinin yarısı kadar boşluk bırakın. Açık zeminde koyu yazılı, koyu zeminde beyaz yazılı logoyu kullanın.",
    onBrand: "Logo, vişne zeminde",
    example: "Kullanım örneği",
    assets: [
      ["Logo, açık zemin için", "ryvex-studio-logo"],
      ["Logo, koyu zemin için", "ryvex-studio-logo-white"],
      ["Sembol", "ryvex-studio-symbol"],
    ],
    colorsTitle: "Renkler",
    productsTitle: "Ürünler",
    contactTitle: "Basın iletişimi",
    contactText: "Röportaj, görsel ya da bilgi talepleriniz için yazın.",
    getLogo: "Logoyu indir",
    writePress: "Basın iletişimi",
  },
  en: {
    title: "Press kit",
    lede: "Everything you need to write about Ryvex Studio.",
    aboutTitle: "About",
    short: "Ryvex Studio is an independent studio making mobile apps, games and web products.",
    long: `Ryvex Studio is an independent digital product studio founded by ${site.founder}. Its mobile apps, games and web products are designed and built under one signature, to the same standard of quality. The studio's tagline: "${site.tagline.en}"`,
    shortLabel: "Short description",
    longLabel: "Long description",
    factsTitle: "Fact sheet",
    facts: [
      ["Founder", site.founder],
      ["Website", "ryvexstudio.com"],
      ["Social media", "@ryvexstudio (Instagram, TikTok, YouTube)"],
      ["Press contact", site.contactEmail],
    ],
    logoTitle: "Logo",
    logoText:
      "Use the logo and symbol as they are: never stretch, rotate, recolor or add effects to them. Leave clear space of at least half the symbol's height around them. Use the dark-text logo on light backgrounds and the white-text logo on dark ones.",
    onBrand: "Logo on cherry",
    example: "Example of use",
    assets: [
      ["Logo, for light backgrounds", "ryvex-studio-logo"],
      ["Logo, for dark backgrounds", "ryvex-studio-logo-white"],
      ["Symbol", "ryvex-studio-symbol"],
    ],
    colorsTitle: "Colors",
    productsTitle: "Products",
    contactTitle: "Press contact",
    contactText: "Write to us for interviews, images or information.",
    getLogo: "Download the logo",
    writePress: "Press contact",
  },
}[lang];

const tiles = [
  { label: copy.assets[0][0], file: copy.assets[0][1], src: "/brand/ryvex-studio-logo.svg", alt: "Ryvex Studio", w: 236, h: 51, bg: "#FFFFFF", fg: "#1C1418", line: "#E2DDE0" },
  { label: copy.assets[1][0], file: copy.assets[1][1], src: "/brand/ryvex-studio-logo-white.svg", alt: "", w: 236, h: 51, bg: "#1C1418", fg: "#FFFFFF", line: "rgb(255 255 255 / 0.35)" },
  { label: copy.assets[2][0], file: copy.assets[2][1], src: "/brand/ryvex-studio-symbol.svg", alt: "", w: 72, h: 72, bg: "#F4F2F3", fg: "#1C1418", line: "#D6CFD3" },
  { label: copy.onBrand, file: "", src: "/brand/ryvex-studio-logo-white.svg", alt: "", w: 236, h: 51, bg: "#8E1B3B", fg: "#FFFFFF", line: "rgb(255 255 255 / 0.35)" },
];

const h2 = "text-headline-md font-semibold";
const block = "border-t border-outline py-12 md:grid md:grid-cols-12 md:gap-6";
---

<!-- The press kit opens like the studio and contact pages: a deep band lit by the products' colours. -->
<section
  class="studio-band relative isolate flex flex-col justify-center overflow-hidden text-primary md:min-h-[calc(100svh-73px)]"
  data-theme="dark"
  data-pattern-light
>
  <BrandPattern color="var(--rv-primary)" opacity={0.06} class="-z-10" />
  <div
    class="studio-glow"
    style={`--c1:${glow[0] ?? "#8E1B3B"};--c2:${glow[1] ?? "#8E1B3B"};--c3:${glow[2] ?? "#8E1B3B"}`}
    aria-hidden="true"
  ></div>
  <div class="container-page w-full pt-20 pb-16 md:py-16">
    <h1 class="hero-settle text-body-lg text-secondary" style="--i:0">{copy.title}</h1>
    <p
      class="rise-words mt-6 max-w-[20ch] text-[2.25rem] leading-[1.06] font-semibold tracking-[-0.04em] md:text-[4rem] md:leading-[1.02]"
    >
      <span class="sr-only">{copy.lede}</span>
      {
        copy.lede.split(" ").map((word, i, all) => (
          <>
            <span class="w" aria-hidden="true">
              <span style={`--i:${i}`}>{word}</span>
            </span>
            {i < all.length - 1 && " "}
          </>
        ))
      }
    </p>
    <div class="hero-settle mt-12 flex flex-wrap gap-3" style="--i:3">
      <a
        href="/brand/ryvex-studio-logo.svg"
        download
        data-magnetic
        class="inline-flex rounded-full bg-[#FFFFFF] px-[24px] py-[15px] text-label font-medium text-[#1C1418] transition-opacity duration-150 hover:opacity-90"
      >
        {copy.getLogo}
      </a>
      <a
        href={`mailto:${site.contactEmail}`}
        class="inline-flex rounded-full border border-outline px-[23px] py-[14px] text-label font-medium transition-colors duration-150 hover:bg-neutral"
      >
        {copy.writePress}
      </a>
    </div>
  </div>
</section>

<div class="container-page py-section-mobile md:py-section">
  <section aria-labelledby="hakkimizda" class={block}>
    <h2 id="hakkimizda" class:list={[h2, "md:col-span-4"]}>{copy.aboutTitle}</h2>
    <div class="mt-6 space-y-8 md:col-span-8 md:mt-0">
      <div>
        <h3 class="text-label font-medium text-secondary">{copy.shortLabel}</h3>
        <p class="mt-2 max-w-[60ch] text-body-lg">{copy.short}</p>
      </div>
      <div>
        <h3 class="text-label font-medium text-secondary">{copy.longLabel}</h3>
        <p class="mt-2 max-w-[60ch] text-body-md">{copy.long}</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="kunye" class={block}>
    <h2 id="kunye" class:list={[h2, "md:col-span-4"]}>{copy.factsTitle}</h2>
    <dl class="mt-6 max-w-[60ch] text-body-md md:col-span-8 md:mt-0">
      {
        copy.facts.map(([label, value]) => (
          <div class="flex justify-between gap-6 border-b border-outline py-3 first:pt-0">
            <dt class="text-secondary">{label}</dt>
            <dd class="text-right">{value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="logo" class={block}>
    <h2 id="logo" class:list={[h2, "md:col-span-4"]}>{copy.logoTitle}</h2>
    <div class="mt-6 md:col-span-8 md:mt-0">
      <!-- Each mark on the grounds it is made for; the files sit on the tile they show. -->
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          tiles.map((tile) => (
            <li
              class="press-tile group relative flex h-56 flex-col justify-between overflow-hidden rounded-[20px] border border-outline p-5"
              style={`background-color:${tile.bg};color:${tile.fg}`}
            >
              <span class="text-body-sm opacity-80">{tile.label}</span>
              <span class="flex flex-1 items-center justify-center">
                <img
                  src={tile.src}
                  alt={tile.alt}
                  width={tile.w}
                  height={tile.h}
                  class="transition-transform duration-500 ease-[var(--ease-settle)] group-hover:scale-[1.04]"
                />
              </span>
              {tile.file ? (
                <span class="flex gap-2">
                  {["svg", "png"].map((ext) => (
                    <a
                      href={`/brand/${tile.file}.${ext}`}
                      download
                      class="inline-flex rounded-full border px-4 py-2 text-label font-medium transition-colors duration-150"
                      style={`border-color:${tile.line};color:${tile.fg}`}
                      aria-label={`${tile.label}, ${ext.toUpperCase()}`}
                    >
                      {ext.toUpperCase()}
                    </a>
                  ))}
                </span>
              ) : (
                <span class="text-body-sm opacity-80">{copy.example}</span>
              )}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-[60ch] text-body-md text-secondary">{copy.logoText}</p>
    </div>
  </section>

  <section aria-labelledby="renkler" class={block}>
    <h2 id="renkler" class:list={[h2, "md:col-span-4"]}>{copy.colorsTitle}</h2>
    <ul class="mt-6 grid grid-cols-3 gap-4 md:col-span-8 md:mt-0">
      {
        colors.map((color) => (
          <li>
            <div
              class="flex aspect-[4/3] items-end rounded-lg border border-outline p-4"
              style={`background-color:${color.hex};color:${color.text}`}
            >
              <span class="font-mono text-mono-sm">{color.hex}</span>
            </div>
            <p class="mt-2 text-body-sm">{color.name}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="urunler-basin" class={block}>
    <h2 id="urunler-basin" class:list={[h2, "md:col-span-4"]}>{copy.productsTitle}</h2>
    <ul class="mt-6 md:col-span-8 md:mt-0">
      {
        products.map((product) => (
          <li class="border-b border-outline first:border-t">
            <a href={`${productBase}/${product.id}`} class="group flex items-center gap-4 py-4">
              <Image src={product.data.icon} alt="" width={48} height={48} class="shape-icon size-12" />
              <span>
                <span class="block text-title font-semibold group-hover:underline">
                  {product.data.name}
                </span>
                <span class="block text-body-sm text-secondary">{productCaption(product, lang)}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="basin-iletisim" class={block}>
    <h2 id="basin-iletisim" class:list={[h2, "md:col-span-4"]}>{copy.contactTitle}</h2>
    <div class="mt-6 md:col-span-8 md:mt-0">
      <p class="text-body-md text-secondary">{copy.contactText}</p>
      <a href={`mailto:${site.contactEmail}`} class="link-inline mt-3 inline-block text-body-md">
        {site.contactEmail}
      </a>
    </div>
  </section>
</div>
