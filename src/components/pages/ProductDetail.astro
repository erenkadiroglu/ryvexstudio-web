---
import { existsSync } from "node:fs";
import ClosingBand from "@/components/ClosingBand.astro";
import LaunchNotify from "@/components/LaunchNotify.astro";
import PhoneFrame from "@/components/PhoneFrame.astro";
import { Image } from "astro:assets";
import { site } from "@/config/site";
import qrcode from "qrcode-generator";
import { launchDateNote, newLabel, newUntil } from "@/lib/launch";
import { iconTransitionName } from "@/lib/transitions";
import { route, type Lang } from "@/i18n/ui";
import {
  comingSoonLabel,
  getProducts,
  platformLabels,
  productCaption,
  productTagline,
  screenFor,
  typeLabels,
  type Product,
} from "@/lib/products";

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;
const { data } = product;

const copy = {
  tr: {
    appStore: "App Store'dan indir",
    googlePlay: "Google Play'den indir",
    web: "Tarayıcıda aç",
    screenshots: "Ekran görüntüleri",
    about: "Ne yapar",
    facts: "Ürün bilgileri",
    developer: "Geliştirici",
    type: "Tür",
    platform: "Platform",
    version: "Sürüm",
    released: "Yayın tarihi",
    privacy: "Gizlilik politikası",
    glance: "Gizlilik özeti",
    releasesFeed: "Sürüm notlarını RSS ile takip edin",
    fullPolicy: "Gizlilik politikasının tamamı",
    support: "Destek",
    back: "Tüm ürünler",
    features: "Öne çıkan özellikler",
    releases: "Sürüm geçmişi",
    latest: "Son sürüm",
    status: "Durum",
    soonNote: (stores: string) => `Yakında ${stores} üzerinden indirilebilecek.`,
    planned: "Çıkış tarihi",
    share: "Paylaş",
    shareCopied: "Bağlantı kopyalandı",
    qrTitle: "Telefonunuzla açın",
    qrText: "Kameranızla okutun; indirme sayfası telefonunuzda açılsın.",
    barFree: "Ücretsiz",
    barGet: "İndir",
    related: "Ailenin diğer üyeleri",
    next: "Sıradaki ürün",
  },
  en: {
    appStore: "Download on the App Store",
    googlePlay: "Get it on Google Play",
    web: "Open in browser",
    screenshots: "Screenshots",
    about: "What it does",
    facts: "Product details",
    developer: "Developer",
    type: "Type",
    platform: "Platform",
    version: "Version",
    released: "Released",
    privacy: "Privacy policy",
    glance: "Privacy at a glance",
    releasesFeed: "Follow release notes via RSS",
    fullPolicy: "Read the full privacy policy",
    support: "Support",
    back: "All products",
    features: "Highlights",
    releases: "Release history",
    latest: "Latest",
    status: "Status",
    soonNote: (stores: string) => `Coming soon to ${stores}.`,
    planned: "Launch date",
    share: "Share",
    shareCopied: "Link copied",
    qrTitle: "Open it on your phone",
    qrText: "Scan with your camera to open the download page on your phone.",
    barFree: "Free",
    barGet: "Get",
    related: "More from the family",
    next: "Next product",
  },
}[lang];

const dateFormat = new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const base = route("products", lang);
const privacyHref = `${base}/${product.id}/${lang === "tr" ? "gizlilik" : "privacy"}`;
const supportHref = `${base}/${product.id}/${lang === "tr" ? "destek" : "support"}`;

const soon = data.status === "coming-soon";
const storeNames = [
  data.platforms.includes("ios") && "App Store",
  data.platforms.includes("android") && "Google Play",
  data.platforms.includes("web") && (lang === "tr" ? "web" : "the web"),
].filter(Boolean) as string[];
const storeList =
  storeNames.length > 1
    ? `${storeNames.slice(0, -1).join(", ")}${lang === "tr" ? " ve " : " and "}${storeNames.at(-1)}`
    : (storeNames[0] ?? "");

// Official store badges are used when their files are in public/badges/ (see the badge guide);
// until then the stores are plain buttons with the same words.
const badgeFile = (store: string) =>
  ["svg", "png"].map((ext) => `badges/${store}-${lang}.${ext}`).find((f) => existsSync(`public/${f}`));
const stores = soon ? [] : [
  data.links.appStore && { store: "app-store", href: data.links.appStore, label: copy.appStore, badge: badgeFile("app-store") },
  data.links.googlePlay && { store: "google-play", href: data.links.googlePlay, label: copy.googlePlay, badge: badgeFile("google-play") },
  data.links.web && { store: "web", href: data.links.web, label: copy.web },
].filter(Boolean) as { store: string; href: string; label: string; badge?: string }[];
const appStores = stores.filter((s) => s.store !== "web");

// A planned launch date replaces "coming soon" while it is ahead; the page checks it again in the
// browser, so a passed date falls back to the plain note even before the next build.
const launchDate = soon && data.releaseDate && data.releaseDate > new Date() ? data.releaseDate : undefined;
const isNew = (newUntil(product) ?? 0) > new Date();

// Desktop visitors can carry the page to their phone: a QR code of this page, made at build time.
const pageUrl = new URL(`${route("products", lang)}/${product.id}`, site.url).href;
const qr = (() => {
  const code = qrcode(0, "M");
  code.addData(pageUrl);
  code.make();
  const n = code.getModuleCount();
  let path = "";
  for (let y = 0; y < n; y++) for (let x = 0; x < n; x++) if (code.isDark(y, x)) path += `M${x} ${y}h1v1h-1z`;
  return { n, path };
})();

// Privacy at a glance, read from the same record as the full policy.
const serverData = data.privacy.dataCollected.filter((d) => d.storage === "server").length;
const thirdParties = data.privacy.thirdParties;
const privacyGlance = {
  tr: [
    { icon: "user", title: data.privacy.accountRequired ? "Hesap gerekir" : "Hesap gerekmez", text: data.privacy.accountRequired ? "Kullanmak için hesap açmanız gerekir." : "Hesap açmadan kullanabilirsiniz." },
    { icon: data.privacy.tracking ? "eye" : "eye-off", title: data.privacy.tracking ? "Reklam takibi var" : "Reklam takibi yok", text: data.privacy.tracking ? "Reklamlar için takip yapılır; ayrıntılar politikada." : "Reklam ya da pazarlama amacıyla takip yapılmaz." },
    { icon: serverData ? "server" : "phone", title: serverData ? `${serverData} veri türü sunucuda` : "Veriler cihazınızda", text: serverData ? "Hangi verinin nerede tutulduğu politikada yazar." : "Hiçbir veri cihazınızdan çıkmaz." },
    { icon: "share", title: thirdParties.length ? `${thirdParties.length} üçüncü taraf hizmet` : "Üçüncü taraf yok", text: thirdParties.length ? thirdParties.map((t) => t.name).join(", ") : "Verileriniz kimseyle paylaşılmaz." },
  ],
  en: [
    { icon: "user", title: data.privacy.accountRequired ? "Account required" : "No account needed", text: data.privacy.accountRequired ? "You need an account to use it." : "Use it without creating an account." },
    { icon: data.privacy.tracking ? "eye" : "eye-off", title: data.privacy.tracking ? "Ad tracking used" : "No ad tracking", text: data.privacy.tracking ? "Tracking is used for ads; details in the policy." : "No tracking for advertising or marketing." },
    { icon: serverData ? "server" : "phone", title: serverData ? `${serverData} ${serverData === 1 ? "kind" : "kinds"} of data on servers` : "Data stays on your device", text: serverData ? "The policy says which data is kept where." : "No data leaves your device." },
    { icon: "share", title: thirdParties.length ? `${thirdParties.length} third-party ${thirdParties.length === 1 ? "service" : "services"}` : "No third parties", text: thirdParties.length ? thirdParties.map((t) => t.name).join(", ") : "Your data is shared with no one." },
  ],
}[lang];

const facts = [
  { label: copy.developer, value: site.name },
  { label: copy.type, value: typeLabels[lang][data.type] },
  { label: copy.platform, value: data.platforms.map((p) => platformLabels[lang][p]).join(", ") },
  soon && { label: copy.status, value: comingSoonLabel[lang] },
  data.version && { label: copy.version, value: data.version, mono: true },
  data.releaseDate && { label: soon ? copy.planned : copy.released, value: dateFormat.format(data.releaseDate) },
].filter(Boolean) as { label: string; value: string; mono?: boolean }[];

// The opening: the product's colour as a soft light behind the phone, over a light tint of it.
const heroGround = (color: string) =>
  `background: radial-gradient(60% 80% at 78% 45%, color-mix(in srgb, ${color} 20%, transparent), transparent 70%), color-mix(in srgb, ${color} 7%, var(--rv-surface));`;

// The product's own colour, mixed into the page surface, carries the top of the page.
const tint = (color: string, pct: number) =>
  `background-color: color-mix(in srgb, ${color} ${pct}%, var(--rv-surface));`;

// Next product (wraps around) and up to three relatives, preferring the same type.
const all = await getProducts();
const index = all.findIndex((p) => p.id === product.id);
const next = all.length > 1 ? all[(index + 1) % all.length] : undefined;
const others = all.filter((p) => p.id !== product.id && p.id !== next?.id);
const related = [
  ...others.filter((p) => p.data.type === data.type),
  ...others.filter((p) => p.data.type !== data.type),
].slice(0, 3);
const kind = data.type === "web" ? "browser" : "phone";
// Only real material is shown: a screenshot in a device, or else the product's own icon.
const firstScreen = data.screenshots[0] ? screenFor(data.screenshots[0], lang) : undefined;
const shot = firstScreen?.src;
// A screen recording, when there is one in this page's language, plays in the opening phone.
const video = lang === "en" ? data.video?.en : data.video?.tr;
// Feature story (desktop): a phone stays put while the features pass; each shows its own screen.
const story = kind === "phone" && data.screenshots.length > 1 && data.features.length > 0;
const phoneWidth = 260;
const bezel = Math.round(phoneWidth * 0.034);
const radius = Math.round(phoneWidth * 0.155);
const camera = Math.round(phoneWidth * 0.036);
---

<article>
  <!-- Product band: header and screenshots sit on the product's own tint. -->
  <div style={heroGround(data.color)}>
    <header class="pd-hero container-page grid items-center gap-12 pt-14 pb-16 md:min-h-[calc(100svh-73px)] md:grid-cols-12 md:py-12" data-pd-hero>
      <div class="md:col-span-7">
        <a href={base} class="group inline-flex items-center gap-2 text-label font-medium text-secondary hover:text-primary">
          <span aria-hidden="true" class="transition-transform duration-300 ease-[var(--ease-settle)] group-hover:-translate-x-1">←</span>
          {copy.back}
        </a>
        <div class="mt-8 flex flex-col gap-8 sm:flex-row sm:items-center sm:gap-10">
          <Image
            src={data.icon}
            alt=""
            width={128}
            height={128}
            class:list={["shape-icon object-depth size-24 md:size-32", !shot && "md:hidden"]}
            style={shot ? `view-transition-name: ${iconTransitionName(product.id)}` : undefined}
          />
          <div>
            <p class="flex flex-wrap items-center gap-2 text-body-sm text-secondary">
              {productCaption(product, lang)}
              {soon && (
                <span class="rounded-full border border-outline px-2.5 py-0.5 text-[0.8125rem] font-medium text-primary">
                  {comingSoonLabel[lang]}
                </span>
              )}
              {isNew && <span class="new-chip hidden" data-new-chip={product.id}>{newLabel[lang]}</span>}
            </p>
            <h1 class="mt-1 text-[2.5rem] leading-[1.05] font-semibold tracking-[-0.035em] md:text-headline-xl">
              {data.name}
            </h1>
          </div>
        </div>
        <p class="mt-8 max-w-[40ch] text-body-lg text-secondary">{productTagline(product, lang)}</p>
        {
          soon && launchDate ? (
            <p
              class="mt-8 text-body-md font-medium text-primary"
              data-launch-date={launchDate.toISOString()}
              data-fallback={storeList ? copy.soonNote(storeList) : comingSoonLabel[lang]}
            >
              {launchDateNote(launchDate, storeList, lang)}
            </p>
          ) : (
            soon && storeList && <p class="mt-8 text-body-md font-medium text-primary">{copy.soonNote(storeList)}</p>
          )
        }
        {soon && <LaunchNotify lang={lang} productId={product.id} productName={data.name} />}
        <!-- Stores (the visitor's own first) and sharing, side by side. -->
        <div class:list={["flex flex-wrap items-center gap-3", stores.length > 0 ? "mt-10" : "mt-6"]}>
          {
            stores.length > 0 && (
              <ul class="pd-stores flex flex-wrap gap-3">
                {stores.map((store) => (
                  <li data-store={store.store}>
                    {store.badge ? (
                      <a href={store.href} rel="noopener" class="inline-block transition-opacity duration-150 hover:opacity-85">
                        <img src={`/${store.badge}`} alt={store.label} height="48" class="h-12 w-auto" />
                      </a>
                    ) : (
                      <a
                        href={store.href}
                        rel="noopener"
                        class="inline-flex rounded-full bg-primary px-[22px] py-[14px] text-label font-medium text-surface transition-opacity duration-150 hover:opacity-85"
                      >
                        {store.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )
          }
          <button
            type="button"
            class="pd-share inline-flex min-h-12 items-center gap-2 rounded-full border border-outline px-5 text-label font-medium text-primary transition-colors duration-150 hover:bg-[color-mix(in_srgb,var(--rv-primary)_6%,transparent)]"
            data-share-title={data.name}
            data-share-text={productTagline(product, lang)}
            data-share-url={pageUrl}
            data-copied={copy.shareCopied}
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 15V3.5M7.5 8 12 3.5 16.5 8M5 12.5V19a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 19v-6.5"></path>
            </svg>
            <span class="pd-share-label">{copy.share}</span>
          </button>
          <span class="sr-only" role="status" data-share-status></span>
        </div>
        {
          appStores.length > 0 && (
            <div class="pd-qr mt-6 hidden max-w-[27rem] items-center gap-5 rounded-2xl border border-outline p-2.5 pr-6 md:flex">
              <svg
                class="pd-qr-code size-[84px] shrink-0 rounded-xl"
                viewBox={`-2 -2 ${qr.n + 4} ${qr.n + 4}`}
                shape-rendering="crispEdges"
                aria-hidden="true"
              >
                <rect x="-2" y="-2" width={qr.n + 4} height={qr.n + 4} fill="#FFFFFF" />
                <path d={qr.path} fill="#1C1418" />
              </svg>
              <p class="text-body-sm text-secondary">
                <strong class="block text-label font-semibold text-primary">{copy.qrTitle}</strong>
                {copy.qrText}
              </p>
            </div>
          )
        }
      </div>

      <!-- Desktop: a real screenshot in the product's device, or the product's own icon. -->
      <div class="hidden justify-center md:col-span-5 md:flex" aria-hidden="true">
        {
          shot && kind === "phone" ? (
            <div class="pd-phone">
              <PhoneFrame src={shot} darkSrc={firstScreen?.dark} video={video} alt="" width={290} fluid loading="eager" fetchpriority="high" />
            </div>
          ) : shot ? (
            <div class="object-depth relative aspect-[16/10] w-full overflow-hidden rounded-[20px] border border-outline bg-surface">
              <Image src={shot} alt="" widths={[400, 800]} sizes="520px" class="absolute inset-0 size-full object-cover object-top" />
            </div>
          ) : (
            <Image
              src={data.icon}
              alt=""
              widths={[256, 512]}
              sizes="256px"
              class="shape-icon object-depth size-64"
              style={`view-transition-name: ${iconTransitionName(product.id)}`}
            />
          )
        }
      </div>
    </header>

    {
      data.screenshots.length > 0 && (
        <div class:list={["container-page pb-16 md:pb-20", story && "md:hidden"]}>
          <div class="-mx-4 overflow-x-auto px-4" tabindex="0" role="region" aria-label={copy.screenshots} data-lenis-prevent>
            <ul class="flex gap-6 pt-1 pb-12">
              {data.screenshots.map((screenshot, i) => {
                const screen = screenFor(screenshot, lang);
                const image = screen.src;
                const alt = `${data.name}: ${screenshot.alt[lang]}`;
                // On desktop the first screen is already in the large phone above.
                const repeatsHero = i === 0 && kind === "phone" && data.screenshots.length > 1;
                return (
                  <li class:list={["shrink-0", repeatsHero && "md:hidden"]}>
                    {kind === "phone" ? (
                      <PhoneFrame src={image} darkSrc={screen.dark} alt={alt} width={216} class="phone-compact" />
                    ) : (
                      <Image src={image} alt={alt} height={400} class="h-[300px] w-auto rounded-lg border border-outline md:h-[400px]" />
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      )
    }
  </div>

  {
    data.features.length > 0 && (
      <section aria-labelledby="ozellikler" class="container-page pt-section-mobile md:pt-section">
        <h2 id="ozellikler" class="text-headline-lg font-semibold">{copy.features}</h2>
        <div class:list={["mt-10", story && "md:mt-6 md:grid md:grid-cols-12 md:gap-6"]} data-story={story ? "" : undefined}>
          {story && (
            <div class="hidden md:col-span-5 md:block" aria-hidden="true">
              <div class="story-stage sticky flex h-[620px] items-center justify-center">
                <div class="phone" style={`width:${phoneWidth}px;padding:${bezel}px;border-radius:${radius}px`}>
                  <div class="phone-screen" style={`border-radius:${radius - bezel}px`}>
                    {data.screenshots.map((screenshot, i) => {
                      const screen = screenFor(screenshot, lang);
                      return (
                        <div
                          class:list={["story-screen absolute inset-0", i === (data.features[0].shot ?? 0) && "is-active"]}
                          data-shot={i}
                        >
                          <Image
                            src={screen.src}
                            alt=""
                            widths={[phoneWidth, phoneWidth * 2]}
                            sizes={`${phoneWidth}px`}
                            class:list={["size-full object-cover object-top", screen.dark && "shot-light"]}
                          />
                          {screen.dark && (
                            <Image
                              src={screen.dark}
                              alt=""
                              widths={[phoneWidth, phoneWidth * 2]}
                              sizes={`${phoneWidth}px`}
                              class="shot-dark size-full object-cover object-top"
                            />
                          )}
                        </div>
                      );
                    })}
                  </div>
                  <span class="phone-camera" style={`width:${camera}px;height:${camera}px;top:${bezel + camera}px`} />
                </div>
              </div>
            </div>
          )}
          <ul class:list={[story ? "md:col-span-6 md:col-start-7" : "grid gap-x-6 gap-y-10 border-t border-outline pt-10 sm:grid-cols-2 lg:grid-cols-3"]}>
            {data.features.map((feature, i) => (
              <li
                class:list={[story && "story-step flex flex-col justify-center border-t border-outline py-10 md:min-h-[620px] md:border-t-0 md:py-0", story && i === 0 && "is-active"]}
                data-shot={feature.shot ?? 0}
              >
                <span class="block h-1 w-10 rounded-full" style={`background-color:${data.color}`} aria-hidden="true" />
                <h3 class:list={["mt-5 font-semibold", story ? "text-[1.75rem] leading-tight tracking-[-0.02em] md:text-[2.5rem]" : "text-title"]}>
                  {feature.title[lang]}
                </h3>
                <p class:list={["mt-3 max-w-[40ch] text-secondary", story ? "text-body-lg" : "text-body-md"]}>{feature.text[lang]}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <div class="container-page py-section-mobile md:py-section">
    <section aria-labelledby="gizlilik-ozeti" class="mb-16 md:mb-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="gizlilik-ozeti" class="text-headline-lg font-semibold">{copy.glance}</h2>
        <a href={privacyHref} class="link-inline text-body-md">{copy.fullPolicy}</a>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          privacyGlance.map((item) => (
            <li class="rounded-xl border border-outline p-6">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style={`color:color-mix(in srgb, ${data.color} 60%, var(--rv-primary))`}>
                {item.icon === "user" && (<><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></>)}
                {item.icon === "eye" && (<><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></>)}
                {item.icon === "eye-off" && (<><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" /><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" /><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" /><path d="m2 2 20 20" /></>)}
                {item.icon === "phone" && (<><rect width="14" height="20" x="5" y="2" rx="2" /><path d="M12 18h.01" /></>)}
                {item.icon === "server" && (<><rect width="20" height="8" x="2" y="2" rx="2" /><rect width="20" height="8" x="2" y="14" rx="2" /><path d="M6 6h.01M6 18h.01" /></>)}
                {item.icon === "share" && (<><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98" /></>)}
              </svg>
              <h3 class="mt-5 text-title font-semibold">{item.title}</h3>
              <p class="mt-2 text-body-sm text-secondary">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="urun-bilgileri" class="rounded-xl bg-neutral p-8 md:p-10">
      <h2 id="urun-bilgileri" class="sr-only">{copy.facts}</h2>
      <dl class="grid gap-x-6 gap-y-6 text-body-sm sm:grid-cols-2 lg:grid-cols-4">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-secondary">{fact.label}</dt>
              <dd class:list={["mt-1 text-title font-semibold", fact.mono && "font-mono"]}>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-8 flex flex-wrap gap-3 border-t border-outline pt-6">
        <a
          href={privacyHref}
          class="inline-flex rounded-full border border-outline bg-surface px-[21px] py-[13px] text-label font-medium transition-colors duration-150 hover:bg-neutral-strong"
        >
          {copy.privacy}
        </a>
        <a
          href={supportHref}
          class="inline-flex rounded-full border border-outline bg-surface px-[21px] py-[13px] text-label font-medium transition-colors duration-150 hover:bg-neutral-strong"
        >
          {copy.support}
        </a>
      </div>
    </section>

    {
      data.releases.length > 0 && (
        <section aria-labelledby="surumler" class="mt-16 max-w-[64ch]">
          <h2 id="surumler" class="text-headline-md font-semibold">{copy.releases}</h2>
          <ol class="mt-6 border-l border-outline">
            {data.releases.map((release, i) => (
              <li class="relative pb-8 pl-6 last:pb-0">
                <span
                  class="absolute top-1.5 -left-[5px] size-[9px] rounded-full"
                  style={`background-color:${i === 0 ? data.color : "var(--rv-outline)"}`}
                  aria-hidden="true"
                />
                <p class="flex flex-wrap items-baseline gap-x-3 text-body-sm">
                  <span class="font-mono text-mono-sm text-primary">{release.version}</span>
                  <time class="text-secondary" datetime={release.date.toISOString().slice(0, 10)}>
                    {dateFormat.format(release.date)}
                  </time>
                  {i === 0 && <span class="font-medium text-primary">{copy.latest}</span>}
                </p>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-body-sm text-secondary marker:text-outline">
                  {release.notes[lang].map((note) => <li>{note}</li>)}
                </ul>
              </li>
            ))}
          </ol>
          <a href={lang === "tr" ? "/urunler/surumler.xml" : "/en/products/releases.xml"} class="link-inline mt-8 inline-block text-body-sm">
            {copy.releasesFeed}
          </a>
        </section>
      )
    }
  </div>

  {
    // A single card next to the "next product" band only repeats it, so the row needs two or more.
    related.length > 1 && (
      <section aria-labelledby="aile" class="container-page pb-section-mobile md:pb-section">
        <h2 id="aile" class="text-headline-md font-semibold">{copy.related}</h2>
        <ul class="mt-8 grid gap-6 sm:grid-cols-3">
          {related.map((p) => (
            <li>
              <a href={`${base}/${p.id}`} data-flood={p.data.color} class="group flex items-center gap-4 rounded-xl border border-outline p-4 transition-colors duration-150 hover:bg-neutral">
                <Image src={p.data.icon} alt="" width={56} height={56} class="shape-icon size-14" />
                <span>
                  <span class="block text-title font-semibold">{p.data.name}</span>
                  <span class="block text-body-sm text-secondary">{productCaption(p, lang)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    next && (
      <a
        href={`${base}/${next.id}`}
        data-flood={next.data.color}
        class="group block border-t border-outline"
        style={tint(next.data.color, 7)}
      >
        <div class="container-page flex items-center justify-between gap-8 py-16 md:py-24">
          <div>
            <p class="text-body-sm text-secondary">{copy.next}</p>
            <p class="mt-2 text-[2.5rem] leading-[1.05] font-semibold tracking-[-0.035em] transition-transform duration-500 ease-[var(--ease-settle)] group-hover:translate-x-2 md:text-headline-xl">
              {next.data.name}
            </p>
            <p class="mt-3 max-w-[40ch] text-body-lg text-secondary">{productTagline(next, lang)}</p>
          </div>
          <Image
            src={next.data.icon}
            alt=""
            width={128}
            height={128}
            class="wall-icon shape-icon object-depth size-20 shrink-0 md:size-32"
            style={`view-transition-name: ${iconTransitionName(next.id)}`}
          />
        </div>
      </a>
    )
  }
  {
    /* Phones: once the store buttons scroll away, the right store stays one tap away at the bottom. */
    appStores.length > 0 && (
      <div class="download-bar md:hidden" data-download-bar data-apple-banner={appStores.some((s) => s.store === "app-store") ? "" : undefined}>
        {appStores.map((store) => (
          <a href={store.href} rel="noopener" class="download-bar-link" data-bar-store={store.store}>
            <Image src={data.icon} alt="" width={44} height={44} class="shape-icon size-11 shrink-0" />
            <span class="min-w-0 flex-1">
              <span class="block truncate text-label font-semibold text-primary">{data.name}</span>
              <span class="block truncate text-[0.8125rem] text-secondary">
                {typeLabels[lang][data.type]} · {store.store === "app-store" ? "App Store" : "Google Play"}
              </span>
            </span>
            <span class="download-bar-get">{copy.barGet}</span>
          </a>
        ))}
      </div>
    )
  }
</article>

<script>
  let storesWatch: IntersectionObserver | null = null;

  document.addEventListener("astro:page-load", () => {
    storesWatch?.disconnect();
    storesWatch = null;

    // Share: the phone's own share sheet where there is one, otherwise the link is copied.
    document.querySelectorAll<HTMLButtonElement>(".pd-share").forEach((button) => {
      button.addEventListener("click", async () => {
        const { shareTitle: title, shareText: text, shareUrl: url = location.href, copied = "" } = button.dataset;
        const share = { title, text, url };
        if (navigator.share && (!navigator.canShare || navigator.canShare(share))) {
          try {
            await navigator.share(share);
          } catch {
            /* the visitor closed the share sheet */
          }
          return;
        }
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          return;
        }
        const label = button.querySelector(".pd-share-label");
        const status = button.parentElement?.querySelector("[data-share-status]");
        const before = label?.textContent ?? "";
        if (label) label.textContent = copied;
        if (status) status.textContent = copied;
        window.setTimeout(() => {
          if (label) label.textContent = before;
          if (status) status.textContent = "";
        }, 2200);
      });
    });

    // A planned launch date that has passed falls back to the plain "coming soon" note.
    document.querySelectorAll<HTMLElement>("[data-launch-date]").forEach((note) => {
      if (Date.parse(note.dataset.launchDate ?? "") <= Date.now()) note.textContent = note.dataset.fallback ?? "";
    });

    const bar = document.querySelector<HTMLElement>("[data-download-bar]");
    const stores = document.querySelector(".pd-stores");
    if (bar && stores) {
      storesWatch = new IntersectionObserver(([entry]) => {
        bar.classList.toggle("is-shown", !entry.isIntersecting && entry.boundingClientRect.top < 0);
      });
      storesWatch.observe(stores);
    }
  });
</script>

<ClosingBand lang={lang} />
