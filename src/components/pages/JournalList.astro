---
import JournalCover from "@/components/JournalCover.astro";
import PageIntro from "@/components/PageIntro.astro";
import { getProducts } from "@/lib/products";
import { route, type Lang } from "@/i18n/ui";
import { getPosts, postSlug, readingMinutes } from "@/lib/journal";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = await getPosts(lang);
const base = route("journal", lang);
const allProducts = await getProducts();
const productsOf = (ids: string[]) => allProducts.filter((p) => ids.includes(p.id));

const copy = {
  tr: {
    title: "Günlük",
    lede: "Ürün duyuruları, sürüm notları ve ürünlerimizin nasıl yapıldığına dair hikâyeler.",
    empty: "Henüz yazı yok.",
    minutes: (n: number) => `${n} dakikalık okuma`,
    rss: "RSS ile takip edin",
  },
  en: {
    title: "Journal",
    lede: "Product announcements, release notes and stories about how our products are made.",
    empty: "No posts yet.",
    minutes: (n: number) => `${n} min read`,
    rss: "Follow via RSS",
  },
}[lang];

const dateFormat = new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<PageIntro title={copy.title} lede={copy.lede} />

<section class="container-page pt-14 pb-section-mobile md:pt-20 md:pb-section">
  {
    posts.length === 0 ? (
      <p class="text-body-md text-secondary">{copy.empty}</p>
    ) : (
      <ol class="grid gap-x-6 gap-y-14 md:grid-cols-2">
        {posts.map((post, i) => (
          <li class:list={[i === 0 && "md:col-span-2"]}>
            <a
              href={`${base}/${postSlug(post)}`}
              class:list={["group", i === 0 ? "grid items-center gap-8 md:grid-cols-12 md:gap-6" : "block"]}
            >
              <JournalCover
                products={productsOf(post.data.products)}
                class:list={[i === 0 ? "aspect-[16/10] rounded-[24px] md:col-span-7" : "aspect-[16/9] rounded-[20px]"]}
              />
              <div class:list={[i === 0 ? "md:col-span-5 md:pl-6" : "mt-5"]}>
                <p class="text-body-sm text-secondary">
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>{dateFormat.format(post.data.date)}</time>
                  <span class="block">{copy.minutes(readingMinutes(post))}</span>
                </p>
                <h2 class="mt-3 text-headline-lg font-semibold decoration-2 underline-offset-[6px] group-hover:underline">
                  {post.data.title}
                </h2>
                <p class="mt-3 max-w-[48ch] text-body-lg text-secondary">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  <a href={`${base}/rss.xml`} class="link-inline mt-10 inline-block text-body-sm">{copy.rss}</a>
</section>
