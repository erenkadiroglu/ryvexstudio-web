---
import PageIntro from "@/components/PageIntro.astro";
import { route, type Lang } from "@/i18n/ui";
import { getPosts, postSlug, readingMinutes } from "@/lib/journal";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = await getPosts(lang);
const base = route("journal", lang);

const copy = {
  tr: {
    title: "Günlük",
    lede: "Ürün duyuruları, sürüm notları ve ürünlerimizin nasıl yapıldığına dair hikâyeler.",
    empty: "Henüz yazı yok.",
    minutes: (n: number) => `${n} dakikalık okuma`,
    rss: "RSS ile takip edin",
  },
  en: {
    title: "Journal",
    lede: "Product announcements, release notes and stories about how our products are made.",
    empty: "No posts yet.",
    minutes: (n: number) => `${n} min read`,
    rss: "Follow via RSS",
  },
}[lang];

const dateFormat = new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<PageIntro title={copy.title} lede={copy.lede} />

<section class="container-page pb-section-mobile md:pb-section">
  {
    posts.length === 0 ? (
      <p class="text-body-md text-secondary">{copy.empty}</p>
    ) : (
      <ol class="border-t border-outline">
        {posts.map((post) => (
          <li class="border-b border-outline">
            <a href={`${base}/${postSlug(post)}`} class="group grid gap-3 py-10 md:grid-cols-12 md:gap-6">
              <p class="text-body-sm text-secondary md:col-span-3">
                <time datetime={post.data.date.toISOString().slice(0, 10)}>
                  {dateFormat.format(post.data.date)}
                </time>
                <span class="block">{copy.minutes(readingMinutes(post))}</span>
              </p>
              <div class="md:col-span-8">
                <h2 class="text-headline-lg font-semibold decoration-2 underline-offset-[6px] group-hover:underline">
                  {post.data.title}
                </h2>
                <p class="mt-3 max-w-[56ch] text-body-lg text-secondary">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  <a href={`${base}/rss.xml`} class="link-inline mt-10 inline-block text-body-sm">{copy.rss}</a>
</section>
