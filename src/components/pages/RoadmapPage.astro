---
import { getImage } from "astro:assets";
import BrandPattern from "@/components/BrandPattern.astro";
import ClosingBand from "@/components/ClosingBand.astro";
import { route, type Lang } from "@/i18n/ui";
import { getProducts } from "@/lib/products";
import { roadmap, text, type RoadmapStatus } from "@/lib/studio";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = {
  tr: {
    eyebrow: "Yol haritası",
    title: "Şu an ne yapıyoruz, sırada ne var?",
    lede: "Ürünlerin bugününü ve yakın planlarını açıkça paylaşıyoruz. Tarih vermiyoruz; hazır olduğunda duyururuz.",
    updated: "Son güncelleme",
    columns: { now: "Üzerinde çalışılıyor", next: "Sırada", done: "Tamamlandı" },
  },
  en: {
    eyebrow: "Roadmap",
    title: "What we're making now, and what's next",
    lede: "We share where each product stands and what's planned next. No dates; we announce things when they're ready.",
    updated: "Last updated",
    columns: { now: "In progress", next: "Next", done: "Done" },
  },
}[lang];

const products = await getProducts();
const base = route("products", lang);
const meta = Object.fromEntries(
  await Promise.all(
    products.map(async (p) => [
      p.id,
      {
        name: p.data.name,
        color: p.data.color,
        icon: (await getImage({ src: p.data.icon, width: 64, format: "webp" })).src,
      },
    ]),
  ),
) as Record<string, { name: string; color: string; icon: string }>;

const order: RoadmapStatus[] = ["now", "next", "done"];
// Items of products that are not on the site (drafts, removed) are left out.
const columns = order.map((status) => ({
  status,
  items: roadmap.items.filter((i) => i.status === status && meta[i.product]),
}));
const updated = new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(roadmap.updated));
---

<section class="relative isolate overflow-hidden" data-pattern-light>
  <BrandPattern color="var(--rv-tertiary)" opacity={0.08} class="-z-10" />
  <div class="container-page py-20 text-center md:py-28">
    <p class="text-label font-medium text-secondary">{copy.eyebrow}</p>
    <h1 class="mx-auto mt-4 max-w-[20ch] text-[2.5rem] leading-[1.05] font-semibold tracking-[-0.035em] md:text-headline-xl">
      {copy.title}
    </h1>
    <p class="mx-auto mt-5 max-w-[52ch] text-body-lg text-secondary">{copy.lede}</p>
    <p class="mt-6 text-body-sm text-secondary">
      {copy.updated}: <time datetime={roadmap.updated}>{updated}</time>
    </p>
  </div>
</section>

<section class="container-page pb-section-mobile md:pb-section" aria-label={copy.eyebrow}>
  <div class="grid gap-6 md:grid-cols-3">
    {columns.map((column) => (
      <section
        class="roadmap-column"
        data-status={column.status}
        aria-labelledby={`rm-${column.status}`}
      >
        <h2 id={`rm-${column.status}`} class="flex items-center gap-3 text-title font-semibold">
          <span class="roadmap-dot" aria-hidden="true" />
          {copy.columns[column.status]}
          <span class="ml-auto text-body-sm font-normal text-secondary">{column.items.length}</span>
        </h2>
        <ul class="mt-5 space-y-3">
          {column.items.map((item) => {
            const product = meta[item.product];
            return (
              <li>
                <a
                  href={`${base}/${item.product}`}
                  class="roadmap-card group"
                  style={`--rm-color:${product.color}`}
                >
                  <span class="flex items-center gap-2.5 text-label font-medium text-secondary">
                    <img
                      src={product.icon}
                      alt=""
                      width="24"
                      height="24"
                      class="shape-icon size-6"
                      loading="lazy"
                    />
                    {product.name}
                  </span>
                  <span class="mt-3 block text-body-md text-primary">{text(item.title, lang)}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</section>

<ClosingBand lang={lang} />
