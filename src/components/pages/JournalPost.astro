---
import { render } from "astro:content";
import { site } from "@/config/site";
import { route, type Lang } from "@/i18n/ui";
import { readingMinutes, type Post } from "@/lib/journal";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { Content } = await render(post);

const copy = {
  tr: { back: "Tüm yazılar", by: "Yazan", minutes: (n: number) => `${n} dakikalık okuma` },
  en: { back: "All posts", by: "By", minutes: (n: number) => `${n} min read` },
}[lang];

const dateFormat = new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<article class="container-page pt-14 pb-section-mobile md:pt-20 md:pb-section">
  <div class="mx-auto max-w-[68ch]">
    <a href={route("journal", lang)} class="group inline-flex items-center gap-2 text-label font-medium text-secondary hover:text-primary">
      <span aria-hidden="true" class="transition-transform duration-300 ease-[var(--ease-settle)] group-hover:-translate-x-1">←</span>
      {copy.back}
    </a>
    <h1 class="mt-10 text-[2.5rem] leading-[1.05] font-semibold tracking-[-0.035em] md:text-headline-xl">
      {post.data.title}
    </h1>
    <p class="mt-5 text-body-lg text-secondary">{post.data.description}</p>
    <p class="mt-8 flex flex-wrap gap-x-4 gap-y-1 border-y border-outline py-4 text-body-sm text-secondary">
      <span>{copy.by} {site.founder}</span>
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{dateFormat.format(post.data.date)}</time>
      <span>{copy.minutes(readingMinutes(post))}</span>
    </p>
    <div class="prose-journal mt-10">
      <Content />
    </div>
  </div>
</article>
