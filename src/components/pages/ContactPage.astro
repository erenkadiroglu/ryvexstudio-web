---
import PageIntro from "@/components/PageIntro.astro";
import { site } from "@/config/site";
import { route, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  tr: {
    title: "İletişim",
    lede: "Size en uygun kanalı seçin. Her mesajı okuyoruz.",
    channels: [
      {
        title: "Genel",
        text: "Sorular, öneriler ve iş birliği fikirleri için.",
        email: site.contactEmail,
      },
      {
        title: "Ürün desteği",
        text: "Bir ürünümüzle ilgili sorun yaşıyorsanız. Her ürünün destek sayfasında sık sorulan sorular da var.",
        email: site.supportEmail,
        link: { href: route("products", "tr"), label: "Ürün destek sayfaları" },
      },
      {
        title: "Basın",
        text: "Röportaj, haber ve içerik talepleri için. Logo ve ürün bilgileri basın kitinde.",
        email: site.contactEmail,
        link: { href: route("press", "tr"), label: "Basın kiti" },
      },
    ],
  },
  en: {
    title: "Contact",
    lede: "Pick the channel that fits best. We read every message.",
    channels: [
      {
        title: "General",
        text: "For questions, suggestions and ideas to work on together.",
        email: site.contactEmail,
      },
      {
        title: "Product support",
        text: "If something isn't working in one of our products. Each product's support page also has answers to common questions.",
        email: site.supportEmail,
        link: { href: route("products", "en"), label: "Product support pages" },
      },
      {
        title: "Press",
        text: "For interviews, news and content requests. Logos and product details are in the press kit.",
        email: site.contactEmail,
        link: { href: route("press", "en"), label: "Press kit" },
      },
    ],
  },
}[lang];
---

<PageIntro title={copy.title} lede={copy.lede} />

<section class="container-page py-section-mobile md:py-section md:pt-20">
  <ul class="grid gap-6 md:grid-cols-3">
    {
      copy.channels.map((channel) => (
        <li class="flex flex-col rounded-xl bg-neutral p-8">
          <h2 class="text-headline-md font-semibold">{channel.title}</h2>
          <p class="mt-3 flex-1 text-body-md text-secondary">{channel.text}</p>
          <a href={`mailto:${channel.email}`} class="link-inline mt-6 text-body-md">
            {channel.email}
          </a>
          {channel.link && (
            <a href={channel.link.href} class="mt-2 text-body-sm text-secondary hover:text-primary">
              {channel.link.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<section aria-labelledby="takip" class="container-page pb-section-mobile md:pb-section">
  <div class="flex flex-col gap-6 border-t border-outline pt-10 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 id="takip" class="text-headline-md font-semibold">{lang === "tr" ? "Bizi takip edin" : "Follow us"}</h2>
      <p class="mt-2 text-body-md text-secondary">
        {lang === "tr" ? "Tüm hesaplarımızda kullanıcı adımız aynı:" : "We use the same handle everywhere:"} @ryvexstudio
      </p>
    </div>
    <ul class="flex flex-wrap gap-2">
      {
        site.social.map((s) => (
          <li>
            <a
              href={s.url}
              rel="me noopener"
              class="inline-flex rounded-full border border-outline px-[21px] py-[13px] text-label font-medium text-primary transition-colors duration-150 hover:bg-neutral active:bg-neutral-strong"
            >
              {s.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
