---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { alternatePath, getLangFromUrl, route, useTranslations } from "@/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const nav = [
  { href: route("products", lang), label: t("nav.products") },
  { href: route("studio", lang), label: t("nav.studio") },
  { href: route("journal", lang), label: t("nav.journal") },
  { href: route("contact", lang), label: t("nav.contact") },
];

const otherLang = lang === "tr" ? "en" : "tr";
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header
  class="site-header sticky top-0 z-40 border-b border-transparent bg-[var(--rv-page)] transition-[background-color,border-color] duration-500 data-[scrolled]:border-outline"
>
  <div class="container-page flex h-[72px] items-center justify-between">
    <Logo href={route("home", lang)} />

    <nav aria-label={t("nav.menu")} class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="rounded-full px-3.5 py-2 text-label font-medium text-primary transition-colors duration-150 hover:bg-neutral aria-[current=page]:bg-neutral"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={alternatePath(Astro.url, otherLang)}
        hreflang={otherLang}
        lang={otherLang}
        class="rounded-full px-3 py-2 text-label font-medium text-secondary transition-colors duration-150 hover:bg-neutral hover:text-primary"
      >
        {otherLang.toUpperCase()}
      </a>
      <ThemeToggle />
      <button
        type="button"
        class="menu-open inline-flex size-10 items-center justify-center rounded-full text-primary transition-colors duration-150 hover:bg-neutral md:hidden"
        aria-label={t("nav.menu")}
        aria-haspopup="dialog"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </nav>
  </div>

  <dialog
    class="mobile-menu m-0 h-dvh max-h-none w-full max-w-none bg-surface p-0 text-primary backdrop:bg-transparent md:hidden"
    aria-label={t("nav.menu")}
  >
    <div class="container-page flex h-[72px] items-center justify-between">
      <Logo href={route("home", lang)} />
      <button
        type="button"
        class="menu-close inline-flex size-10 items-center justify-center rounded-full hover:bg-neutral"
        aria-label={t("nav.close")}
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <ul class="container-page mt-8 space-y-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="block py-2 text-headline-lg font-semibold aria-[current=page]:text-tertiary"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </dialog>
</header>

<script>
  const getMenu = () => document.querySelector<HTMLDialogElement>(".mobile-menu");
  const updateHeader = () =>
    document
      .querySelector<HTMLElement>(".site-header")
      ?.toggleAttribute("data-scrolled", window.scrollY > 4);

  // Window-level listeners are registered once; element listeners on every page load.
  window.addEventListener("scroll", updateHeader, { passive: true });
  window.matchMedia("(min-width: 960px)").addEventListener("change", (e) => {
    if (e.matches) getMenu()?.close();
  });

  document.addEventListener("astro:page-load", () => {
    const menu = getMenu();
    document.querySelector(".menu-open")?.addEventListener("click", () => menu?.showModal());
    document.querySelector(".menu-close")?.addEventListener("click", () => menu?.close());
    menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.close()));
    updateHeader();
  });
</script>
