---
import { Image, getImage } from "astro:assets";

interface Props {
  /** A real screenshot taken on a phone or emulator (portrait, about 9:20). */
  src: ImageMetadata;
  alt: string;
  /** Outer width of the phone in CSS pixels; the bezel and corners scale with it. */
  width: number;
  /** Fill the parent's width instead; the bezel and corners follow it (container units). */
  fluid?: boolean;
  /** The same screen in the app's dark theme, shown when the site is in its dark theme. */
  darkSrc?: ImageMetadata;
  /** A looping screen recording (path under /videos/) shown in place of the still image. */
  video?: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto";
  style?: string;
}

const { src, alt, width, fluid = false, darkSrc, video, class: className, loading = "lazy", fetchpriority, style } = Astro.props;
// The still is also the video's poster, so the frame is never empty while the video loads.
const poster = video ? (await getImage({ src, width: width * 2, format: "webp" })).src : undefined;

// Proportions of a current flat-screen Android phone with a centred punch-hole camera.
const bezel = Math.round(width * 0.034);
const radius = Math.round(width * 0.155);
const camera = Math.max(6, Math.round(width * 0.036));
---

{
  fluid ? (
    <div class:list={["phone-fluid", className]} style={style}>
      <div class="phone phone--fluid">
        <div class="phone-screen">
          {video ? (
            <video
              class="size-full object-cover object-top"
              muted
              loop
              playsinline
              preload="metadata"
              poster={poster}
              data-autoplay
              aria-label={alt || undefined}
              aria-hidden={alt ? undefined : "true"}
            >
              <source src={video} type="video/mp4" />
            </video>
          ) : (
            <>
              <Image
                src={src}
                alt={alt}
                widths={[width, width * 2]}
                sizes={`${width}px`}
                loading={loading}
                fetchpriority={fetchpriority}
                class:list={["size-full object-cover object-top", darkSrc && "shot-light"]}
              />
              {darkSrc && (
                <Image
                  src={darkSrc}
                  alt={alt}
                  widths={[width, width * 2]}
                  sizes={`${width}px`}
                  loading="lazy"
                  class="shot-dark size-full object-cover object-top"
                />
              )}
            </>
          )}
        </div>
        <span class="phone-camera" aria-hidden="true" />
      </div>
    </div>
  ) : (
    <div
      class:list={["phone", className]}
      style={`width:${width}px; padding:${bezel}px; border-radius:${radius}px;${style ? ` ${style}` : ""}`}
    >
      <div class="phone-screen" style={`border-radius:${radius - bezel}px`}>
        <Image
          src={src}
          alt={alt}
          widths={[width, width * 2]}
          sizes={`${width}px`}
          loading={loading}
          fetchpriority={fetchpriority}
          class:list={["size-full object-cover object-top", darkSrc && "shot-light"]}
        />
        {darkSrc && (
          <Image
            src={darkSrc}
            alt={alt}
            widths={[width, width * 2]}
            sizes={`${width}px`}
            loading="lazy"
            class="shot-dark size-full object-cover object-top"
          />
        )}
      </div>
      <span
        class="phone-camera"
        style={`width:${camera}px; height:${camera}px; top:${bezel + camera}px`}
        aria-hidden="true"
      />
    </div>
  )
}
