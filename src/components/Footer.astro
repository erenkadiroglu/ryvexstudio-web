---
import Logo from "./Logo.astro";
import { site } from "@/config/site";
import { getLangFromUrl, route, useTranslations } from "@/i18n/ui";
import { getProducts } from "@/lib/products";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const products = (await getProducts()).slice(0, 5);
const productBase = route("products", lang);

const columns = [
  {
    title: t("footer.products"),
    links: [
      ...products.map((p) => ({ href: `${productBase}/${p.id}`, label: p.data.name })),
      { href: productBase, label: t("footer.allProducts") },
    ],
  },
  {
    title: t("footer.studio"),
    links: [
      { href: route("studio", lang), label: t("nav.studio") },
      { href: route("press", lang), label: t("footer.press") },
      { href: route("contact", lang), label: t("nav.contact") },
    ],
  },
  {
    title: t("footer.legal"),
    links: [
      { href: route("privacy", lang), label: t("footer.privacy") },
      { href: route("terms", lang), label: t("footer.terms") },
      { href: route("kvkk", lang), label: t("footer.kvkk") },
      { href: route("cookies", lang), label: t("footer.cookies") },
    ],
  },
];
---

<footer class="bg-neutral text-body-sm text-secondary">
  <div class="container-page grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo href={route("home", lang)} />
      <p class="mt-4 max-w-[32ch]">{site.tagline[lang]}</p>
    </div>
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
      {
        columns.map((column) => (
          <div>
            <h2 class="text-label font-medium text-primary">{column.title}</h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="transition-colors duration-150 hover:text-primary">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="container-page">
    <p class="border-t border-outline py-6">© {year} {site.name}. {t("footer.rights")}</p>
  </div>
</footer>
