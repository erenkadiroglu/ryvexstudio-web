---
import Logo from "./Logo.astro";
import { site } from "@/config/site";
import { getLangFromUrl, route, useTranslations } from "@/i18n/ui";
import { getProducts } from "@/lib/products";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const products = (await getProducts()).slice(0, 5);
const productBase = route("products", lang);

const columns = [
  {
    title: t("footer.products"),
    links: [
      ...products.map((p) => ({ href: `${productBase}/${p.id}`, label: p.data.name })),
      { href: productBase, label: t("footer.allProducts") },
    ],
  },
  {
    title: t("footer.studio"),
    links: [
      { href: route("studio", lang), label: t("nav.studio") },
      { href: route("journal", lang), label: t("nav.journal") },
      { href: route("roadmap", lang), label: t("footer.roadmap") },
      { href: route("help", lang), label: t("footer.help") },
      { href: route("press", lang), label: t("footer.press") },
      { href: route("contact", lang), label: t("nav.contact") },
    ],
  },
  {
    title: t("footer.legal"),
    links: [
      { href: route("privacy", lang), label: t("footer.privacy") },
      { href: route("terms", lang), label: t("footer.terms") },
      { href: route("kvkk", lang), label: t("footer.kvkk") },
      { href: route("cookies", lang), label: t("footer.cookies") },
      { href: route("accessibility", lang), label: t("footer.accessibility") },
    ],
  },
];
import NewsletterForm from "@/components/NewsletterForm.astro";
---

<footer class="bg-neutral text-body-sm text-secondary">
  <NewsletterForm lang={lang} />
  <div class="container-page grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo href={route("home", lang)} />
      <p class="mt-4 max-w-[32ch]">{site.tagline[lang]}</p>
      <h2 class="sr-only">{t("footer.follow")}</h2>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          site.social.map((s) => (
            <li>
              <a
                href={s.url}
                rel="me noopener"
                class="inline-flex rounded-full border border-outline px-4 py-2 text-label font-medium text-primary transition-colors duration-150 hover:bg-neutral-strong"
              >
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
      {
        columns.map((column) => (
          <div>
            <h2 class="text-label font-medium text-primary">{column.title}</h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="transition-colors duration-150 hover:text-primary">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="container-page">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-outline py-6">
      <p>© {year} {site.name}. {t("footer.rights")}</p>
      {/* True as long as nothing on the site sets a cookie; see the cookie policy. */}
      <a href={route("cookies", lang)} class="inline-flex items-center gap-2 hover:text-primary">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6l-7-3Z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        {t("footer.noCookies")}
      </a>
    </div>
    <!-- The studio's name, set across the full width of the page, rises into place at the very end. -->
    <div class="footer-word overflow-hidden pb-2" data-reveal-on-view="end" aria-hidden="true">
      <svg class="block w-full text-primary" viewBox="0 0 1000 172" focusable="false">
        <text
          x="0"
          y="142"
          textLength="1000"
          lengthAdjust="spacingAndGlyphs"
          fill="currentColor"
          font-size="190"
          font-weight="600"
          letter-spacing="-8"
        >
          {site.name}
        </text>
      </svg>
    </div>
  </div>
</footer>
