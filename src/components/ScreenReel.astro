---
import PhoneFrame from "@/components/PhoneFrame.astro";
import type { Lang } from "@/i18n/ui";
import type { Product } from "@/lib/products";

interface Props {
  products: Product[];
  lang: Lang;
}

const { products, lang } = Astro.props;

const copy = {
  tr: { label: "Ürünlerimizden ekranlar" },
  en: { label: "Screens from our products" },
}[lang];

// Interleave the products so neighbouring phones are never the same app.
const lists = products.map((p) => p.data.screenshots.map((s) => ({ product: p, shot: s })));
const longest = Math.max(0, ...lists.map((l) => l.length));
const screens = Array.from({ length: longest }, (_, i) => lists.map((l) => l[i])).flat().filter(Boolean);
---

{
  screens.length > 0 && (
    <section class="screen-reel overflow-hidden bg-neutral py-16 md:py-24" aria-label={copy.label} tabindex="0">
      <!-- The track holds the screens twice so the loop has no seam; the copy is hidden from assistive tech. -->
      <div class="screen-reel-track flex w-max">
        {[0, 1].map((copyIndex) => (
          <ul class="flex shrink-0 gap-8 pr-8 md:gap-10 md:pr-10" aria-hidden={copyIndex === 1 ? "true" : undefined}>
            {screens.map(({ product, shot }) => (
              <li class="shrink-0" style={`--tint:${product.data.color}`}>
                <PhoneFrame
                  src={shot.src}
                  alt={copyIndex === 0 ? `${product.data.name}: ${shot.alt[lang]}` : ""}
                  width={200}
                  class="phone-compact"
                />
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>
  )
}
