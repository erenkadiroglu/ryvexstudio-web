---
/**
 * "Try it here": a small, honest taste of the product in the page. Each demo uses the product's
 * own content (PathWords' first level, a hand from PerSayar's own screen, FileConvert's page
 * editor) and says plainly that it is a demo. Its script loads only when the section comes near.
 */
import type { Lang } from "@/i18n/ui";

interface Props {
  product: string;
  color: string;
  lang: Lang;
}

const { product, color, lang } = Astro.props;
const demos = ["pathwords", "persayar", "fileconvert"];
const copy = {
  tr: {
    eyebrow: "Burada deneyin",
    titles: {
      pathwords: "İlk bölümü oynayın",
      persayar: "Bir eli dizin",
      fileconvert: "Sayfaları düzenleyin",
    },
    ledes: {
      pathwords:
        "Harfleri sürükleyerek ya da sırayla dokunarak birleştirin; her kelime bir hayvan.",
      persayar:
        "Istakadaki taşları seri ve çift olarak dizin; PerSayar eli açıp açamayacağınızı söylesin.",
      fileconvert:
        "Sayfaları sürükleyip sıralayın, döndürün ya da silin. Uygulamada bunu kendi PDF'lerinizle yaparsınız.",
    },
    note: "Bu, sitede çalışan küçük bir deneme. Hiçbir şey kaydedilmez ya da gönderilmez.",
    noscript: "Denemeyi görmek için JavaScript'i açın.",
  },
  en: {
    eyebrow: "Try it here",
    titles: {
      pathwords: "Play the first level",
      persayar: "Arrange a hand",
      fileconvert: "Arrange the pages",
    },
    ledes: {
      pathwords: "Join the letters by dragging or tapping them in order; every word is an animal.",
      persayar:
        "Arrange the tiles on the rack into runs and pairs, and PerSayar tells you whether you can open.",
      fileconvert:
        "Drag pages into order, rotate or delete them. In the app you do this with your own PDFs.",
    },
    note: "This is a small demo running on the site. Nothing is saved or sent.",
    noscript: "Turn on JavaScript to see the demo.",
  },
}[lang];
const key = product as keyof typeof copy.titles;
---

{demos.includes(product) && (
  <section
    class="demo-section py-section-mobile md:py-section"
    aria-labelledby="deneyin"
    style={`--demo-color:${color}`}
  >
    <div class="container-page text-center">
      <p class="text-label font-medium text-secondary">{copy.eyebrow}</p>
      <h2 id="deneyin" class="mt-3 text-headline-lg font-semibold">
        {copy.titles[key]}
      </h2>
      <p class="mx-auto mt-4 max-w-[52ch] text-body-md text-secondary">{copy.ledes[key]}</p>
      <div class="demo-stage mx-auto mt-10" data-demo={product} data-lang={lang}>
        <noscript>
          <p class="py-16 text-body-md text-secondary">{copy.noscript}</p>
        </noscript>
      </div>
      <p class="mx-auto mt-6 max-w-[52ch] text-body-sm text-secondary">{copy.note}</p>
    </div>
  </section>
)}

<script>
  // Each demo's code is fetched only when its section is about to be seen.
  const loaders: Record<
    string,
    () => Promise<{ mount: (el: HTMLElement, lang: "tr" | "en") => void }>
  > = {
    pathwords: () => import("@/scripts/demos/pathwords"),
    persayar: () => import("@/scripts/demos/persayar"),
    fileconvert: () => import("@/scripts/demos/fileconvert"),
  };

  let watch: IntersectionObserver | null = null;
  document.addEventListener("astro:page-load", () => {
    watch?.disconnect();
    const stage = document.querySelector<HTMLElement>("[data-demo]");
    if (!stage) return;
    watch = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        watch?.disconnect();
        const load = loaders[stage.dataset.demo ?? ""];
        void load?.().then((demo) => demo.mount(stage, stage.dataset.lang === "en" ? "en" : "tr"));
      },
      { rootMargin: "400px" },
    );
    watch.observe(stage);
  });
</script>
