---
import { Image } from "astro:assets";
import PhoneFrame from "@/components/PhoneFrame.astro";
import { route, type Lang } from "@/i18n/ui";
import { typeSlugs, type Product, type ProductType } from "@/lib/products";

interface Props {
  products: Product[];
  lang: Lang;
}

const { products, lang } = Astro.props;

const copy = {
  tr: {
    heading: "Ne yapıyoruz",
    soon: "Yakında",
    items: {
      app: {
        title: "Uygulamalar",
        link: "Uygulamaları gör",
      },
      game: {
        title: "Oyunlar",
        link: "Oyunları gör",
      },
      web: {
        title: "Web",
        link: "Web projelerini gör",
      },
    },
  },
  en: {
    heading: "What we make",
    soon: "Coming soon",
    items: {
      app: {
        title: "Apps",
        link: "See the apps",
      },
      game: {
        title: "Games",
        link: "See the games",
      },
      web: {
        title: "Web",
        link: "See the web products",
      },
    },
  },
}[lang];

const types: ProductType[] = ["app", "game", "web"];
// A soft wash from the first product's colour into the second's (or into the page).
const panelStyle = (list: Product[]) => {
  const a = list[0].data.color;
  const b = list[1]?.data.color ?? a;
  return `background: linear-gradient(150deg, color-mix(in srgb, ${a} 22%, var(--rv-surface)), color-mix(in srgb, ${b} 18%, var(--rv-surface)));`;
};
const param = lang === "tr" ? "tur" : "type";
---

<section aria-labelledby="ne-yapiyoruz" class="container-page pb-section-mobile md:pb-section">
  <h2 id="ne-yapiyoruz" class="text-headline-xl font-semibold tracking-[-0.035em]">
    {copy.heading}
  </h2>

  <div class="mt-14 grid gap-x-6 gap-y-14 md:grid-cols-3">
    {
      types.map((type) => {
        const item = copy.items[type];
        const ofType = products.filter((p) => p.data.type === type);
        const slug = lang === "tr" ? typeSlugs[type] : type;
        return (
          <article class="group flex flex-col">
            <!-- The products of this kind: their own colours, icons and real screens. -->
            <div
              class:list={[
                "relative aspect-[16/11] overflow-hidden rounded-xl md:aspect-[4/5]",
                ofType.length === 0 && "flex items-center justify-center bg-neutral",
              ]}
              style={ofType.length > 0 ? panelStyle(ofType) : undefined}
            >
              {ofType.length === 0 && <span class="text-title font-medium text-secondary">{copy.soon}</span>}
              {ofType.length > 0 && (
                <ul class="absolute top-6 left-6 flex gap-2" aria-label={item.title}>
                  {ofType.map((product) => (
                    <li>
                      <Image
                        src={product.data.icon}
                        alt={product.data.name}
                        title={product.data.name}
                        widths={[44, 88]}
                        sizes="44px"
                        class="shape-icon object-depth size-11"
                      />
                    </li>
                  ))}
                </ul>
              )}
              {ofType.length > 0 && (
                <div class="absolute inset-x-0 bottom-0 flex translate-y-[38%] justify-center gap-4 transition-transform duration-700 ease-[var(--ease-settle)] group-hover:translate-y-[34%]" aria-hidden="true">
                  {ofType.slice(0, 2).map((product, i) =>
                    product.data.screenshots[0] ? (
                      <PhoneFrame
                        src={product.data.screenshots[0].src}
                        alt=""
                        width={ofType.length > 1 ? 150 : 170}
                        class="phone-compact"
                        style={ofType.length > 1 ? `rotate:${i === 0 ? -4 : 4}deg` : undefined}
                      />
                    ) : null,
                  )}
                </div>
              )}
            </div>
            <h3 class="mt-6 text-headline-md font-semibold">{item.title}</h3>
            {ofType.length > 0 && (
              <a href={`${route("products", lang)}?${param}=${slug}`} class="link-inline mt-5 self-start text-body-md">
                {item.link}
              </a>
            )}
          </article>
        );
      })
    }
  </div>
</section>
