---
import { Image } from "astro:assets";
import { route, type Lang } from "@/i18n/ui";
import { typeSlugs, type Product, type ProductType } from "@/lib/products";

interface Props {
  products: Product[];
  lang: Lang;
}

const { products, lang } = Astro.props;

const copy = {
  tr: {
    heading: "Ne yapıyoruz",
    soon: "Yakında",
    items: {
      app: {
        title: "Uygulamalar",
        link: "Uygulamaları gör",
      },
      game: {
        title: "Oyunlar",
        link: "Oyunları gör",
      },
      web: {
        title: "Web",
        link: "Web projelerini gör",
      },
    },
  },
  en: {
    heading: "What we make",
    soon: "Coming soon",
    items: {
      app: {
        title: "Apps",
        link: "See the apps",
      },
      game: {
        title: "Games",
        link: "See the games",
      },
      web: {
        title: "Web",
        link: "See the web products",
      },
    },
  },
}[lang];

const types: ProductType[] = ["app", "game", "web"];
const param = lang === "tr" ? "tur" : "type";
---

<section aria-labelledby="ne-yapiyoruz" class="container-page pb-section-mobile md:pb-section">
  <h2 id="ne-yapiyoruz" class="text-headline-xl font-semibold tracking-[-0.035em]">
    {copy.heading}
  </h2>

  <div class="mt-14 grid gap-x-6 gap-y-14 md:grid-cols-3">
    {
      types.map((type) => {
        const item = copy.items[type];
        const ofType = products.filter((p) => p.data.type === type);
        const slug = lang === "tr" ? typeSlugs[type] : type;
        return (
          <article class="group flex flex-col">
            <!-- The products of this kind, by their own icons; no stock photography. -->
            <div
              class:list={[
                "flex aspect-[16/10] flex-wrap content-center items-center justify-center gap-6 rounded-xl p-8 md:aspect-[4/3]",
                ofType.length > 0 ? "bg-neutral" : "border border-dashed border-outline",
              ]}
            >
              {ofType.map((product) => (
                <Image
                  src={product.data.icon}
                  alt={product.data.name}
                  title={product.data.name}
                  widths={[112, 224]}
                  sizes="112px"
                  class="shape-icon object-depth size-24 transition-transform duration-700 ease-[var(--ease-settle)] group-hover:-translate-y-1 md:size-28"
                />
              ))}
            </div>
            <h3 class="mt-6 text-headline-md font-semibold">{item.title}</h3>
            {ofType.length > 0 ? (
              <a href={`${route("products", lang)}?${param}=${slug}`} class="link-inline mt-5 self-start text-body-md">
                {item.link}
              </a>
            ) : (
              <p class="mt-5 text-body-md font-medium text-primary">{copy.soon}</p>
            )}
          </article>
        );
      })
    }
  </div>
</section>
