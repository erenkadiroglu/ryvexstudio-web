---
import Image from "@/components/Img.astro";
import { route, type Lang } from "@/i18n/ui";
import type { Product } from "@/lib/products";
import { iconTransitionName } from "@/lib/transitions";

interface Props {
  product: Product;
  lang: Lang;
  title: string;
  updated?: Date;
}

const { product, lang, title, updated } = Astro.props;
const productHref = `${route("products", lang)}/${product.id}`;
const dateText = updated
  ? new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-US", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(updated)
  : undefined;
const updatedLabel = lang === "tr" ? "Son güncelleme" : "Last updated";
---

<article class="container-page pt-14 pb-section-mobile md:pt-20 md:pb-section">
  <div class="mx-auto max-w-[64ch]">
    <a href={productHref} class="inline-flex items-center gap-3 text-label font-medium text-secondary hover:text-primary">
      <Image
        src={product.data.icon}
        alt=""
        width={32}
        height={32}
        class="shape-icon size-8"
        style={`view-transition-name: ${iconTransitionName(product.id)}`}
      />
      {product.data.name}
    </a>
    <h1 class="mt-8 text-[2.5rem] leading-[1.05] font-semibold tracking-[-0.035em] md:text-headline-xl">
      {title}
    </h1>
    {
      dateText && updated && (
        <p class="mt-4 text-body-sm text-secondary">
          {updatedLabel}: <time datetime={updated.toISOString().slice(0, 10)}>{dateText}</time>
        </p>
      )
    }
    <div class="text-body-md text-secondary">
      <slot />
    </div>
  </div>
</article>
