---
interface Props {
  href?: string;
  class?: string;
}

const { href = "/", class: className = "" } = Astro.props;
// Each instance needs its own clip-path id: the logo appears in the header, menu and footer.
const clipId = `rv-logo-${Math.random().toString(36).slice(2, 8)}`;
---

<a href={href} class:list={["inline-flex items-center gap-2.5 text-primary", className]}>
  <svg class="size-7 shrink-0" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <clipPath id={clipId}><rect width="64" height="64" rx="14.4"></rect></clipPath>
    <rect width="64" height="64" rx="14.4" fill="#8E1B3B"></rect>
    <g clip-path={`url(#${clipId})`} fill="none" stroke="#FFFFFF" stroke-width="8">
      <path d="M24 16V48"></path>
      <path d="M20 20H33A7 7 0 0 1 33 34H24" stroke-linejoin="round"></path>
      <path d="M31 34L64 67"></path>
    </g>
  </svg>
  <span class="text-[1.0625rem] tracking-[-0.02em]">
    <span class="font-semibold">Ryvex</span> <span class="font-normal">Studio</span>
  </span>
</a>
