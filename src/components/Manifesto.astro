---
import type { Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const text = {
  tr: "Az ürün yapıyoruz. Her birini, kendimiz kullanmak isteyeceğimiz hâle gelene kadar işliyoruz.",
  en: "We make few products, and refine each one until we would want to use it ourselves.",
}[lang];

const words = text.split(" ");
---

<section
  class="manifesto container-page py-section-mobile md:py-section"
  aria-label={lang === "tr" ? "Manifesto" : "Manifesto"}
>
  <p
    class="max-w-[20ch] text-[2.25rem] leading-[1.15] font-semibold tracking-[-0.03em] md:text-[4.5rem] md:leading-[1.02]"
  >
    {
      words.map((word, i) => (
        <>
          <span class="manifesto-word">{word}</span>
          {i < words.length - 1 && " "}
        </>
      ))
    }
  </p>
  <p class="mt-10 text-title font-semibold text-tertiary">Ryvex Studio</p>
</section>
