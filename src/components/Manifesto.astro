---
import type { Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  tr: {
    label: "Yaklaşımımız",
    text: "Bir ürünü, adımızı taşımaya hazır olduğunda yayınlıyoruz.",
  },
  en: {
    label: "Our approach",
    text: "We release a product only when it is ready to carry our name.",
  },
}[lang];

const words = copy.text.split(" ");
---

<!-- One statement, centred, set large; its words fill with ink as it is read. -->
<section class="manifesto container-page flex flex-col justify-center py-section-mobile text-center md:min-h-[78svh] md:py-16" aria-label={copy.label}>
  <!-- The studio's mark signs the statement. -->
  <svg class="mx-auto size-10" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <clipPath id="rv-manifesto-mark"><rect width="64" height="64" rx="14.4"></rect></clipPath>
    <rect width="64" height="64" rx="14.4" fill="#8E1B3B"></rect>
    <g clip-path="url(#rv-manifesto-mark)" fill="none" stroke="#FFFFFF" stroke-width="8">
      <path d="M24 16V48"></path>
      <path d="M20 20H33A7 7 0 0 1 33 34H24" stroke-linejoin="round"></path>
      <path d="M31 34L64 67"></path>
    </g>
  </svg>
  <p
    class="mx-auto mt-10 max-w-[22ch] text-[2.25rem] leading-[1.12] font-semibold tracking-[-0.035em] text-balance md:text-[3.75rem] md:leading-[1.06]"
  >
    {
      words.map((word, i) => (
        <>
          <span class="manifesto-word">{word}</span>
          {i < words.length - 1 && " "}
        </>
      ))
    }
  </p>
  </section>
