---
import { Image } from "astro:assets";
import type { Lang } from "@/i18n/ui";
import type { Product } from "@/lib/products";

interface Props {
  products: Product[];
  lang: Lang;
}

const { products, lang } = Astro.props;
const byId = (id: string) => products.find((p) => p.id === id);

// Every figure is read off the products' own screens or code; none is rounded up.
const facts = [
  {
    product: byId("fileconvert"),
    value: 95,
    tr: { before: "%", after: "", text: "FileConvert'te bir PDF'in küçülme oranı: 3,3 MB'tan 164 KB'a." },
    en: { before: "", after: "%", text: "How much smaller a PDF became in FileConvert: from 3.3 MB to 164 KB." },
  },
  {
    product: byId("persayar"),
    value: 21,
    tr: { before: "", after: " taş", text: "PerSayar'ın tek bir ıstaka fotoğrafından, telefonun içinde tanıdığı taş sayısı." },
    en: { before: "", after: " tiles", text: "Tiles PerSayar recognises from a single photo of a rack, on the phone itself." },
  },
  {
    product: byId("pathwords"),
    value: 5,
    tr: { before: "", after: " dünya", text: "PathWords'te keşfedilecek dünya; hazır bölümler bitince oyun yenilerini üretir." },
    en: { before: "", after: " worlds", text: "Worlds to explore in PathWords; when the made levels run out, the game makes new ones." },
  },
].filter((f) => f.product);

const heading = { tr: "Rakamlarla", en: "In numbers" }[lang];
---

<section aria-labelledby="rakamlarla" class="container-page pb-section-mobile md:pb-section" data-results>
  <h2 id="rakamlarla" class="text-headline-xl font-semibold tracking-[-0.035em]">{heading}</h2>
  <ul class="mt-12 grid gap-10 md:mt-14 md:grid-cols-3 md:gap-6">
    {
      facts.map((fact) => {
        const t = fact[lang];
        const color = fact.product!.data.color;
        return (
          <li class="border-t border-outline pt-8">
            <p
              class="text-[4.5rem] leading-none font-semibold tracking-[-0.05em] tabular-nums md:text-[6rem]"
              style={`color: color-mix(in srgb, ${color} 55%, var(--rv-primary))`}
            >
              <span class="sr-only">{`${t.before}${fact.value}${t.after}`}</span>
              <span aria-hidden="true">
                {t.before}
                <span data-count={fact.value}>{fact.value}</span>
                <span class="text-[0.45em] tracking-[-0.02em]">{t.after}</span>
              </span>
            </p>
            <div class="mt-6 flex items-start gap-4">
              <Image src={fact.product!.data.icon} alt="" widths={[36, 72]} sizes="36px" class="shape-icon size-9 shrink-0" />
              <p class="max-w-[34ch] text-body-md text-secondary">{t.text}</p>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
