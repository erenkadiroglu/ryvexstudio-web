---
import type { Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  tr: {
    heading: "Nasıl çalışıyoruz",
    lede: "Fikirden yayına, her ürün aynı yoldan geçer.",
    steps: [
      ["Fikir", "Bir ihtiyaçtan ya da bir oyun fikrinden yola çıkarız. Önce şunu sorarız: bu gerçekten gerekli mi?"],
      ["Tasarım", "Arayüzü her ekran için ayrı düşünür, metni ve akışı ürünle birlikte yazarız."],
      ["Geliştirme", "Uygulama, oyun ya da web; hepsi aynı kalite standardından geçer. Verinize saygı en baştan tasarıma katılır."],
      ["Yayın", "Ürün mağazaya çıkmadan önce gizlilik politikası ve destek sayfası hazırdır."],
      ["Destek", "Yayından sonra da güncellemeler ve geri bildirimlerle ürünü işlemeye devam ederiz."],
    ],
  },
  en: {
    heading: "How we work",
    lede: "From idea to launch, every product takes the same path.",
    steps: [
      ["Idea", "We start from a real need or a game idea, and first ask: is this truly needed?"],
      ["Design", "We think through the interface for every screen and write the copy and flow together with the product."],
      ["Build", "App, game or web product, each one meets the same standard. Respect for your data is designed in from the start."],
      ["Launch", "Before a product reaches the store, its privacy policy and support page are ready."],
      ["Support", "After launch, we keep refining the product with updates and feedback."],
    ],
  },
}[lang];
---

<section aria-labelledby="nasil-calisiyoruz" class="container-page py-section-mobile md:py-section">
  <h2 id="nasil-calisiyoruz" class="text-headline-xl font-semibold tracking-[-0.035em]">
    {copy.heading}
  </h2>
  <p class="mt-4 max-w-[44ch] text-body-lg text-secondary">{copy.lede}</p>

  <!-- A real sequence, so the steps are numbered. -->
  <ol class="mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-5">
    {
      copy.steps.map(([title, text], i) => (
        <li class="relative border-t border-outline pt-6">
          <span
            class="absolute -top-[5px] left-0 size-[9px] rounded-full bg-tertiary"
            aria-hidden="true"
          />
          <span class="text-body-sm font-medium text-secondary tabular-nums">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 text-title font-semibold">{title}</h3>
          <p class="mt-2 text-body-sm text-secondary">{text}</p>
        </li>
      ))
    }
  </ol>
</section>
