---
import { Image } from "astro:assets";
import { route, type Lang } from "@/i18n/ui";
import { comingSoonLabel, productCaption, productTagline, type Product } from "@/lib/products";

interface Props {
  products: Product[];
  lang: Lang;
}

const { products, lang } = Astro.props;
const base = route("products", lang);

const copy = {
  tr: {
    heading: "Öne çıkanlar",
    cta: "Ürünü incele",
  },
  en: {
    heading: "Featured",
    cta: "View product",
  },
}[lang];

// A device frame only when there is a real screenshot to put in it; otherwise the
// product's own icon stands on a panel in its colour.
const kindOf = (product: Product) =>
  product.data.screenshots[0] ? (product.data.type === "web" ? "browser" : "phone") : "stage";
const panel = (color: string) => `background-color: color-mix(in srgb, ${color} 22%, var(--rv-surface));`;
---

<!--
  A full-bleed band in the ink color. data-theme="dark" scopes the dark tokens to this
  section, so text and surfaces inside it stay readable in both page themes.
-->
<section
  class="showcase showcase-band py-section-mobile text-primary md:py-section"
  data-theme="dark"
  aria-labelledby="one-cikanlar"
>
  <div class="container-page">
    <h2 id="one-cikanlar" class="text-headline-xl font-semibold tracking-[-0.035em]">
      {copy.heading}
    </h2>

    <div class="mt-16 md:grid md:grid-cols-12 md:gap-6">
      <!-- Sticky device, desktop only: its screen and shape follow the active step. -->
      <div class="hidden md:col-span-6 md:block" aria-hidden="true">
        <div class="sticky top-[calc(50vh-290px)] flex h-[580px] items-center justify-center">
          <div
            class="showcase-device group relative overflow-hidden border border-outline bg-surface data-[kind=browser]:aspect-[16/10] data-[kind=browser]:w-full data-[kind=browser]:rounded-[20px] data-[kind=phone]:aspect-[9/19.5] data-[kind=phone]:w-[270px] data-[kind=phone]:rounded-[42px] data-[kind=stage]:aspect-[4/5] data-[kind=stage]:w-[440px] data-[kind=stage]:rounded-[28px]"
            data-kind={kindOf(products[0])}
          >
            <div
              class="absolute inset-x-0 top-0 z-10 hidden h-8 items-center gap-1.5 border-b border-outline bg-surface px-4 group-data-[kind=browser]:flex"
            >
              <span class="size-2 rounded-full bg-neutral-strong"></span>
              <span class="size-2 rounded-full bg-neutral-strong"></span>
              <span class="size-2 rounded-full bg-neutral-strong"></span>
            </div>
            {
              products.map((product) => (
                <div class="showcase-screen absolute inset-0" style={product.data.screenshots[0] ? undefined : panel(product.data.color)}>
                  {product.data.screenshots[0] ? (
                    <Image
                      src={product.data.screenshots[0]}
                      alt=""
                      class="absolute inset-0 size-full object-cover"
                      widths={[400, 800]}
                      sizes="520px"
                    />
                  ) : (
                    <div class="flex size-full items-center justify-center">
                      <Image src={product.data.icon} alt="" widths={[192, 384]} sizes="192px" class="shape-icon object-depth size-48" />
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <ul class="md:col-span-5 md:col-start-8">
        {
          products.map((product) => (
            <li
              class="showcase-step flex flex-col justify-center border-t border-outline py-12 md:min-h-[72vh] md:border-t-0 md:py-0"
              data-color={product.data.color}
              data-kind={kindOf(product)}
            >
              <div
                class="relative mb-8 flex aspect-[16/10] w-full items-center justify-center overflow-hidden rounded-xl md:hidden"
                style={panel(product.data.color)}
                aria-hidden="true"
              >
                {product.data.screenshots[0] ? (
                  <Image src={product.data.screenshots[0]} alt="" widths={[400, 800]} sizes="100vw" class="absolute inset-0 size-full object-cover" />
                ) : (
                  <Image src={product.data.icon} alt="" widths={[112, 224]} sizes="112px" class="shape-icon object-depth size-28" />
                )}
              </div>
              <div class="flex items-center gap-3">
                <Image src={product.data.icon} alt="" width={40} height={40} class="shape-icon size-10" />
                <p class="text-body-sm text-secondary">{productCaption(product, lang)}</p>
                {product.data.status === "coming-soon" && (
                  <span class="rounded-full border border-outline px-2.5 py-0.5 text-[0.8125rem] font-medium text-primary">
                    {comingSoonLabel[lang]}
                  </span>
                )}
              </div>
              <h3 class="mt-5 text-headline-lg font-semibold">{product.data.name}</h3>
              <p class="mt-4 max-w-[36ch] text-body-lg text-secondary">
                {productTagline(product, lang)}
              </p>
              <a
                href={`${base}/${product.id}`}
                class="mt-8 inline-flex self-start rounded-full border border-outline px-[21px] py-[13px] text-label font-medium text-primary transition-colors duration-150 hover:bg-neutral active:bg-neutral-strong"
              >
                {copy.cta}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
