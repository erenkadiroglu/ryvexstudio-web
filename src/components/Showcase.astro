---
import { Image } from "astro:assets";
import { route, type Lang } from "@/i18n/ui";
import { productCaption, productTagline, type Product } from "@/lib/products";

interface Props {
  products: Product[];
  lang: Lang;
}

const { products, lang } = Astro.props;
const base = route("products", lang);

const copy = {
  tr: { heading: "Öne çıkanlar", cta: "Ürünü incele" },
  en: { heading: "Featured", cta: "View product" },
}[lang];

const kindOf = (product: Product) => (product.data.type === "web" ? "browser" : "phone");
const screenTint = (product: Product) =>
  `background-color: color-mix(in srgb, ${product.data.color} 14%, var(--color-surface));`;
---

<section
  class="showcase container-page pb-section-mobile md:pb-section"
  aria-labelledby="one-cikanlar"
>
  <h2 id="one-cikanlar" class="text-headline-lg font-semibold">{copy.heading}</h2>

  <div class="mt-12 md:grid md:grid-cols-12 md:gap-6">
    <!-- Sticky device, desktop only: its screen and shape follow the active step. -->
    <div class="hidden md:col-span-6 md:block" aria-hidden="true">
      <div class="sticky top-[calc(50vh-280px)] flex h-[560px] items-center justify-center">
        <div
          class="showcase-device group relative overflow-hidden border border-outline bg-surface data-[kind=browser]:aspect-[16/10] data-[kind=browser]:w-full data-[kind=browser]:rounded-[20px] data-[kind=phone]:aspect-[9/19.5] data-[kind=phone]:w-[260px] data-[kind=phone]:rounded-[40px]"
          data-kind={kindOf(products[0])}
          style="box-shadow: var(--rv-object-shadow)"
        >
          <div
            class="absolute inset-x-0 top-0 z-10 hidden h-8 items-center gap-1.5 border-b border-outline bg-surface px-4 group-data-[kind=browser]:flex"
          >
            <span class="size-2 rounded-full bg-neutral-strong"></span>
            <span class="size-2 rounded-full bg-neutral-strong"></span>
            <span class="size-2 rounded-full bg-neutral-strong"></span>
          </div>
          {
            products.map((product) => (
              <div
                class="showcase-screen absolute inset-0 flex flex-col items-center justify-center gap-4"
                style={screenTint(product)}
              >
                {product.data.screenshots[0] ? (
                  <Image
                    src={product.data.screenshots[0]}
                    alt=""
                    class="absolute inset-0 size-full object-cover"
                    widths={[400, 800]}
                    sizes="520px"
                  />
                ) : (
                  <>
                    <Image src={product.data.icon} alt="" width={96} height={96} class="shape-icon size-24" />
                    <span class="text-title font-semibold">{product.data.name}</span>
                  </>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <ul class="md:col-span-5 md:col-start-8">
      {
        products.map((product) => (
          <li
            class="showcase-step flex flex-col justify-center border-t border-outline py-12 md:min-h-[70vh] md:border-t-0 md:py-0"
            data-color={product.data.color}
            data-kind={kindOf(product)}
          >
            <div
              class="mb-8 flex aspect-[16/10] w-full items-center justify-center rounded-xl md:hidden"
              style={screenTint(product)}
              aria-hidden="true"
            >
              <Image src={product.data.icon} alt="" width={72} height={72} class="shape-icon size-18" />
            </div>
            <p class="text-body-sm text-secondary">{productCaption(product, lang)}</p>
            <h3 class="mt-2 text-headline-lg font-semibold">{product.data.name}</h3>
            <p class="mt-4 max-w-[36ch] text-body-lg text-secondary">{productTagline(product, lang)}</p>
            <a href={`${base}/${product.id}`} class="link-inline mt-6 self-start text-body-md">
              {copy.cta}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
