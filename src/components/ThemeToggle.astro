---
import { getLangFromUrl, useTranslations } from "@/i18n/ui";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<button
  type="button"
  class="theme-toggle inline-flex size-10 items-center justify-center rounded-full text-primary transition-colors duration-150 hover:bg-neutral"
  data-label-dark={t("theme.toDark")}
  data-label-light={t("theme.toLight")}
  aria-label={t("theme.toDark")}
>
  <svg class="icon-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg class="icon-sun hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = "rv-theme";

  function sync(button: HTMLButtonElement, theme: string) {
    const isDark = theme === "dark";
    button.querySelector(".icon-moon")?.classList.toggle("hidden", isDark);
    button.querySelector(".icon-sun")?.classList.toggle("hidden", !isDark);
    button.setAttribute(
      "aria-label",
      (isDark ? button.dataset.labelLight : button.dataset.labelDark) ?? "",
    );
  }

  // Runs on the first load and after every client-side navigation.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((button) => {
      sync(button, document.documentElement.dataset.theme ?? "light");

      button.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch {
          /* storage unavailable: theme still applies for this visit */
        }
        document
          .querySelectorAll<HTMLButtonElement>(".theme-toggle")
          .forEach((b) => sync(b, next));
      });
    });
  });
</script>
