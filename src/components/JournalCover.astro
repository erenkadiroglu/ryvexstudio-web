---
import { Image } from "astro:assets";
import type { Product } from "@/lib/products";

interface Props {
  /** The products the post is about; with none, the studio's own mark stands alone. */
  products: Product[];
  class?: string;
}

const { products, class: className } = Astro.props;
const colors = products.map((p) => p.data.color);
const c = (i: number) => colors[i] ?? colors[0] ?? "#8E1B3B";
---

<!-- A post's cover: a deep ground lit by its products' colours, with their icons. Decorative. -->
<div
  class:list={["journal-cover relative isolate flex items-center justify-center overflow-hidden", className]}
  style={`--c1:${c(0)};--c2:${c(1)};--c3:${c(2)}`}
  aria-hidden="true"
>
  {
    products.length > 0 ? (
      <div class="journal-cover-icons flex items-center gap-4 md:gap-6">
        {products.slice(0, 4).map((product, i) => (
          <Image
            src={product.data.icon}
            alt=""
            widths={[96, 192]}
            sizes="96px"
            class="shape-icon size-16 shadow-[0_24px_48px_-20px_rgb(0_0_0/0.6)] md:size-24"
            style={`--i:${i}`}
          />
        ))}
      </div>
    ) : (
      <svg class="size-20" viewBox="0 0 64 64" focusable="false">
        <rect width="64" height="64" rx="14.4" fill="#8E1B3B" />
        <g fill="none" stroke="#FFFFFF" stroke-width="8">
          <path d="M24 16V48" />
          <path d="M20 20H33A7 7 0 0 1 33 34H24" stroke-linejoin="round" />
          <path d="M31 34L52 55" />
        </g>
      </svg>
    )
  }
</div>
