---
/**
 * A quiet, abstract interface sketch in the product's color.
 * Stands in for real screenshots until they are added to a product.
 */
import { Image } from "astro:assets";
import type { Product } from "@/lib/products";

interface Props {
  product: Product;
  /** Variation so several sketches of one product don't look identical. */
  variant?: number;
  class?: string;
}

const { product, variant = 0, class: className = "" } = Astro.props;
const { type, color, icon } = product.data;

// Uses the raw --rv-* tokens so the sketch follows a section-level data-theme (e.g. the dark band).
const tone = (pct: number) => `color-mix(in srgb, ${color} ${pct}%, var(--rv-surface))`;
const ink = (pct: number) => `color-mix(in srgb, var(--rv-primary) ${pct}%, var(--rv-surface))`;

const rows = [0, 1, 2, 3, 4].slice(0, 5 - (variant % 2));
const tiles = Array.from({ length: 16 }, (_, i) => (i * 7 + variant * 3) % 5 === 0);
---

<div
  class:list={["absolute inset-0 flex flex-col", className]}
  style={`background-color:${tone(10)}`}
  aria-hidden="true"
>
  {
    type === "web" ? (
      <div class="mt-8 flex flex-1 gap-3 p-4">
        <div class="flex w-1/4 flex-col gap-2 rounded-lg p-3" style={`background-color:${tone(18)}`}>
          <Image src={icon} alt="" width={28} height={28} class="shape-icon mb-2 size-7" />
          {[70, 55, 62, 48].map((w) => (
            <span class="h-2 rounded-full" style={`width:${w}%;background-color:${ink(14)}`} />
          ))}
        </div>
        <div class="flex flex-1 flex-col gap-3">
          <span class="h-3 w-2/5 rounded-full" style={`background-color:${ink(22)}`} />
          <div class="grid grid-cols-3 gap-3">
            {[0, 1, 2].map((i) => (
              <div
                class="aspect-[4/3] rounded-lg"
                style={`background-color:${i === variant % 3 ? tone(55) : tone(22)}`}
              />
            ))}
          </div>
          <div class="flex flex-1 items-end gap-2 rounded-lg p-3" style={`background-color:${tone(16)}`}>
            {[40, 65, 50, 80, 58, 72, 45].map((h) => (
              <span class="flex-1 rounded-t-sm" style={`height:${h}%;background-color:${tone(48)}`} />
            ))}
          </div>
        </div>
      </div>
    ) : type === "game" ? (
      <div class="flex flex-1 flex-col items-center justify-center gap-5 px-6 pt-10 pb-8">
        <div class="flex w-full items-center justify-between">
          <span class="h-3 w-1/4 rounded-full" style={`background-color:${ink(18)}`} />
          <span class="h-5 w-1/4 rounded-full" style={`background-color:${tone(30)}`} />
        </div>
        <div class="grid w-full grid-cols-4 gap-2">
          {tiles.map((on) => (
            <span
              class="aspect-square rounded-md"
              style={`background-color:${on ? color : tone(24)}`}
            />
          ))}
        </div>
        <span class="mt-auto h-10 w-3/4 rounded-full" style={`background-color:${color}`} />
      </div>
    ) : (
      <div class="flex flex-1 flex-col gap-4 px-5 pt-10 pb-6">
        <div class="flex items-center gap-3">
          <Image src={icon} alt="" width={32} height={32} class="shape-icon size-8" />
          <span class="h-3 w-2/5 rounded-full" style={`background-color:${ink(24)}`} />
        </div>
        <div class="flex h-24 flex-col justify-end gap-2 rounded-2xl p-4" style={`background-color:${color}`}>
          <span class="h-2 w-1/3 rounded-full bg-white/70" />
          <span class="h-3 w-3/5 rounded-full bg-white" />
        </div>
        {
          rows.map((_, i) => (
            <div class="flex items-center gap-3">
              <span class="size-8 shrink-0 rounded-full" style={`background-color:${tone(i % 2 ? 22 : 34)}`} />
              <div class="flex flex-1 flex-col gap-1.5">
                <span class="h-2 rounded-full" style={`width:${70 - i * 6}%;background-color:${ink(18)}`} />
                <span class="h-2 rounded-full" style={`width:${45 + i * 5}%;background-color:${ink(9)}`} />
              </div>
            </div>
          ))
        }
      </div>
    )
  }
</div>
