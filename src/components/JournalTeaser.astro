---
import { route, type Lang } from "@/i18n/ui";
import JournalCover from "@/components/JournalCover.astro";
import { getPosts, postSlug } from "@/lib/journal";
import { getProducts } from "@/lib/products";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = (await getPosts(lang)).slice(0, 3);
const base = route("journal", lang);
const allProducts = await getProducts();
const productsOf = (ids: string[]) => allProducts.filter((p) => ids.includes(p.id));
const [first, ...rest] = posts;

const copy = {
  tr: { heading: "Günlükten", all: "Tüm yazılar" },
  en: { heading: "From the journal", all: "All posts" },
}[lang];

const dateFormat = new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

{
  posts.length > 0 && (
    <section aria-labelledby="gunlukten" class="container-page py-section-mobile md:py-section">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="gunlukten" class="text-headline-xl font-semibold tracking-[-0.035em]">
          {copy.heading}
        </h2>
        <a href={base} class="link-inline text-body-md">
          {copy.all}
        </a>
      </div>
      {first && (
        <a href={`${base}/${postSlug(first)}`} class="group mt-10 grid items-center gap-8 md:grid-cols-12 md:gap-6">
          <JournalCover products={productsOf(first.data.products)} class="aspect-[16/10] rounded-[24px] md:col-span-7" />
          <span class="md:col-span-5 md:pl-6">
            <time class="block text-body-sm text-secondary" datetime={first.data.date.toISOString().slice(0, 10)}>
              {dateFormat.format(first.data.date)}
            </time>
            <span class="mt-3 block text-headline-lg font-semibold decoration-2 underline-offset-[6px] group-hover:underline">
              {first.data.title}
            </span>
            <span class="mt-3 block max-w-[44ch] text-body-lg text-secondary">{first.data.description}</span>
          </span>
        </a>
      )}
      {rest.length > 0 && (
        <ul class="mt-14 grid gap-10 md:grid-cols-2">
          {rest.map((post) => (
            <li>
              <a href={`${base}/${postSlug(post)}`} class="group block">
                <JournalCover products={productsOf(post.data.products)} class="aspect-[16/9] rounded-[20px]" />
                <time class="mt-5 block text-body-sm text-secondary" datetime={post.data.date.toISOString().slice(0, 10)}>
                  {dateFormat.format(post.data.date)}
                </time>
                <span class="mt-2 block text-headline-md font-semibold decoration-2 underline-offset-[5px] group-hover:underline">
                  {post.data.title}
                </span>
                <span class="mt-2 block max-w-[52ch] text-body-md text-secondary">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}
