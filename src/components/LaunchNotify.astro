---
/**
 * "Tell me when it launches" for a product that is not out yet. Sign-ups go to the Buttondown list
 * tagged with the product, so the launch email reaches only the people who asked for it. Shown only
 * once a Buttondown username is set in src/config/integrations.json, like the footer newsletter.
 */
import { site } from "@/config/site";
import { route, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
  productId: string;
  productName: string;
}

const { lang, productId, productName } = Astro.props;
const user = site.integrations.newsletterUser;
const kvkk = route("kvkk", lang);
const fieldId = `haber-${productId}`;

const copy = {
  tr: {
    label: "E-posta adresiniz",
    button: "Çıkınca haber ver",
    note: `Yalnızca ${productName} çıktığında tek bir e-posta.`,
    consent: "Ayrıntılar",
    consentLink: "aydınlatma metninde",
    consentEnd: "; istediğiniz an ayrılabilirsiniz.",
    sent: "Neredeyse tamam: e-postanıza gelen onay bağlantısına basın.",
  },
  en: {
    label: "Your email address",
    button: "Tell me at launch",
    note: `One email, only when ${productName} launches.`,
    consent: "Details in the",
    consentLink: "personal data notice",
    consentEnd: "; leave whenever you like.",
    sent: "Almost done: press the confirmation link in your email.",
  },
}[lang];
---

{user && (
  <form
    class="launch-notify mt-8 max-w-[30rem]"
    action={`https://buttondown.com/api/emails/embed-subscribe/${user}`}
    method="post"
    target="_blank"
  >
    <div class="launch-field">
      <label class="sr-only" for={fieldId}>
        {copy.label}
      </label>
      <input
        id={fieldId}
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder={copy.label}
        aria-describedby={`${fieldId}-note`}
      />
      <input type="hidden" name="tag" value={productId} />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">{copy.button}</button>
    </div>
    <p id={`${fieldId}-note`} class="mt-3 text-body-sm text-secondary">
      {copy.note} {copy.consent}{" "}
      <a href={kvkk} class="underline decoration-outline underline-offset-4 hover:text-primary">
        {copy.consentLink}
      </a>
      {copy.consentEnd}
    </p>
    <p
      class="launch-sent mt-3 text-body-sm font-medium text-primary"
      role="status"
      data-sent={copy.sent}
    ></p>
  </form>
)}

<script>
  // The confirmation opens in a new tab; this page says what happens next.
  document.addEventListener("submit", (event) => {
    const form = (event.target as Element | null)?.closest<HTMLFormElement>(".launch-notify");
    if (!form) return;
    const status = form.querySelector<HTMLElement>(".launch-sent");
    if (status) status.textContent = status.dataset.sent ?? "";
  });
</script>
